<Window x:Class="SpokaSoundBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SpokaSoundBoard.Views"
        xmlns:conv="clr-namespace:SpokaSoundBoard.Converters"
        Title="SpokaSoundBoard" Width="1280" Height="820" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Settings.Appearance.UiScale}" ScaleY="{Binding Settings.Appearance.UiScale}" />
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="250" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Settings.Appearance.SidebarCollapsed}" Value="True">
                                <Setter Property="Width" Value="72" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0"
                views:LayoutAssist.Compact="{Binding Settings.Appearance.SidebarCollapsed}">
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Margin" Value="14,18,14,14" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Settings.Appearance.SidebarCollapsed}" Value="True">
                                <Setter Property="Margin" Value="10,18,10,14" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <!-- Header: logo, name and the collapse button (under the logo when collapsed) -->
                <DockPanel DockPanel.Dock="Top">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Margin" Value="2,0,0,24" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Settings.Appearance.SidebarCollapsed}" Value="True">
                                    <Setter Property="Margin" Value="0,0,0,16" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <Button Content="&#xE700;" VerticalAlignment="Center" Padding="6" Command="{Binding ToggleSidebarCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="DockPanel.Dock" Value="Right" />
                                <Setter Property="ToolTip" Value="Réduire le menu" />
                                <Setter Property="AutomationProperties.Name" Value="Réduire le menu" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.Appearance.SidebarCollapsed}" Value="True">
                                        <Setter Property="DockPanel.Dock" Value="Bottom" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="0,12,0,0" />
                                        <Setter Property="ToolTip" Value="Afficher le menu" />
                                        <Setter Property="AutomationProperties.Name" Value="Afficher le menu" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Image Source="Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="DockPanel.Dock" Value="Left" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.Appearance.SidebarCollapsed}" Value="True">
                                        <Setter Property="DockPanel.Dock" Value="Top" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Settings.Appearance.SidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="SpokaSoundBoard" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Soundboard &amp; voix" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>

                <!-- Compact status: mic toggle, two small meters and the engine state -->
                <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding Settings.Appearance.SidebarCollapsed, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding ToggleMicCommand}" Width="48" Height="48" Padding="0" HorizontalAlignment="Center"
                            AutomationProperties.Name="Couper / activer votre voix (la musique continue)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                <Setter Property="Background" Value="#2622C55E" />
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                <Setter Property="ToolTip" Value="Micro actif : cliquez pour couper votre voix (la musique continue)" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mix.MicEnabled}" Value="False">
                                        <Setter Property="Background" Value="#33F43F5E" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="ToolTip" Value="Micro coupé : cliquez pour réactiver votre voix" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE720;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mix.MicEnabled}" Value="False">
                                            <Setter Property="Text" Value="&#xF781;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <StackPanel Visibility="{Binding Settings.Appearance.ShowSidebarMeters, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding MicLevel, Mode=OneWay}" Height="4" Margin="2,10,2,0" ToolTip="Votre voix" />
                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding MediaLevel, Mode=OneWay}" Height="4" Margin="2,4,2,0"
                                     Foreground="{DynamicResource BrandBrush}" ToolTip="Musique &amp; sons" />
                    </StackPanel>
                    <Ellipse Width="10" Height="10" Margin="0,12,0,0" HorizontalAlignment="Center" ToolTip="{Binding EngineStatus}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EngineRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineError}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" HorizontalAlignment="Center" Margin="0,6,0,0"
                            ToolTip="Redémarrer l'audio" AutomationProperties.Name="Redémarrer l'audio" Command="{Binding RestartEngineCommand}"
                            Visibility="{Binding EngineError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Live status card -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14" Margin="0"
                        Visibility="{Binding Settings.Appearance.SidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel>
                        <Button Command="{Binding ToggleMicCommand}" Height="48" Margin="0,0,0,14" ToolTip="Couper / activer votre voix (la musique continue)" AutomationProperties.Name="Couper / activer votre voix (la musique continue)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                    <Setter Property="Background" Value="#2622C55E" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mix.MicEnabled}" Value="False">
                                            <Setter Property="Background" Value="#33F43F5E" />
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="18" Margin="0,0,10,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Text" Value="&#xE720;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mix.MicEnabled}" Value="False">
                                                    <Setter Property="Text" Value="&#xF781;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Micro actif" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mix.MicEnabled}" Value="False">
                                                    <Setter Property="Text" Value="Micro coupé" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <StackPanel Visibility="{Binding Settings.Appearance.ShowSidebarMeters, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Votre voix" Style="{StaticResource Caption}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource IdleDotBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Transmitting}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Text" Value="silence" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VoiceActive}" Value="True">
                                                    <Setter Property="Text" Value="vous parlez" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding MicLevel, Mode=OneWay}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Musique &amp; sons" Style="{StaticResource Caption}" />
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}"
                                       Text="{Binding DuckReductionDb, StringFormat=ducking {0:0} dB}" />
                        </Grid>
                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding MediaLevel, Mode=OneWay}" Margin="0,0,0,10"
                                     Foreground="{DynamicResource BrandBrush}" />

                        <TextBlock Text="Sortie jeu" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding OutputLevel, Mode=OneWay}" Margin="0,0,0,10" />

                        <StackPanel Visibility="{Binding Devices.HasDiscordOutput, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Sortie Discord" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ProgressBar Style="{StaticResource Meter}" Value="{Binding DiscordLevel, Mode=OneWay}" Margin="0,0,0,10" />
                        </StackPanel>
                        <Border Height="2" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EngineRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EngineError}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding EngineStatus}" Style="{StaticResource Caption}" MaxWidth="170" />
                        </StackPanel>
                        <TextBlock Text="Coupures audio récentes" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource WarningBrush}"
                                   Visibility="{Binding AudioGlitchesRecent, Converter={StaticResource BoolToVis}}"
                                   ToolTip="Le son a peut-être été coupé ou a grésillé dans la dernière minute (PC très occupé, disque lent…). Détails dans Configuration → Aide et signalement." />
                        <Button Content="Redémarrer l'audio" Style="{StaticResource FlatButton}" Margin="0,10,0,0" Padding="8,5"
                                FontSize="12" Command="{Binding RestartEngineCommand}"
                                Visibility="{Binding EngineError, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE8A9;" Content="Soundboard"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsConv}, ConverterParameter=soundboard}" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE8BD;" Content="Synthèse vocale"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsConv}, ConverterParameter=tts}" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE8D6;" Content="Musique"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsConv}, ConverterParameter=music}" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE7FC;" Content="Blind test"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsConv}, ConverterParameter=blindtest}" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE720;" Content="Voix &amp; effets"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsConv}, ConverterParameter=voice}" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE9E9;" Content="Mixage &amp; ducking"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsConv}, ConverterParameter=mix}" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE713;" Content="Configuration"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsConv}, ConverterParameter=settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Pages ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="0,0,0,1"
                    Padding="20,10" Visibility="{Binding Devices.HasVirtualCable, Converter={StaticResource InverseBoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Installer maintenant" Style="{StaticResource AccentButton}" Padding="12,6"
                            Command="{Binding NavigateCommand}" CommandParameter="settings" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Micro virtuel non détecté : installez VB-CABLE (gratuit) pour que vos amis entendent la musique et vos effets." />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1"
                    Padding="20,10" Visibility="{Binding AvailableUpdate, Converter={StaticResource NullToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource FlatButton}" Content="Plus tard" Padding="10,6" Margin="0,0,8,0" Command="{Binding SkipUpdateCommand}" />
                        <Button Style="{StaticResource FlatButton}" Content="Nouveautés" Padding="10,6" Margin="0,0,8,0" Command="{Binding OpenReleaseNotesCommand}" />
                        <Button Style="{StaticResource AccentButton}" Padding="12,6" Command="{Binding InstallUpdateCommand}"
                                IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBool}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Mettre à jour" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="Nouvelle version disponible :" />
                            <Run Text="{Binding AvailableUpdate.Tag, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <ProgressBar Style="{StaticResource Meter}" Height="4" Margin="0,6,0,0" Maximum="100" Width="240" HorizontalAlignment="Left"
                                     Value="{Binding UpdateProgress, Mode=OneWay}" Foreground="{DynamicResource BrandBrush}"
                                     Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <views:SoundboardView DataContext="{Binding Soundboard}"
                                      Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter=soundboard}" />
                <views:TextToSpeechView DataContext="{Binding Soundboard.Tts}"
                                        Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter=tts}" />
                <views:MusicView DataContext="{Binding Music}"
                                 Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter=music}" />
                <views:BlindTestView DataContext="{Binding BlindTest}"
                                     Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter=blindtest}" />
                <views:VoiceView Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVis}, ConverterParameter=voice}" />
                <views:MixView Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVis}, ConverterParameter=mix}" />
                <views:SettingsView Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVis}, ConverterParameter=settings}" />
            </Grid>
        </Grid>

        <!-- ============ Player bar ============ -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,12" DataContext="{Binding Music}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>

                <DockPanel VerticalAlignment="Center" LastChildFill="True">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Padding="0" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="music" ToolTip="Ouvrir la musique" AutomationProperties.Name="Ouvrir la musique">
                        <Border Width="50" Height="50" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" ClipToBounds="True">
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="20" Foreground="{DynamicResource Accent2Brush}" />
                                <Image Source="{Binding CurrentTrack.ThumbnailUrl, Converter={StaticResource Cover}}" Stretch="UniformToFill" />
                                <ProgressBar IsIndeterminate="True" VerticalAlignment="Bottom" Height="3" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                    </Button>
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleIconButton}" FontSize="14" ToolTip="Favori" AutomationProperties.Name="Favori"
                                  IsChecked="{Binding CurrentTrack.IsFavorite, Mode=OneWay}" Command="{Binding ToggleFavoriteCurrentCommand}"
                                  Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xEB51;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTrack.IsFavorite}" Value="True">
                                            <Setter Property="Text" Value="&#xEB52;" />
                                            <Setter Property="Foreground" Value="#F472B6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ToggleButton>
                    <StackPanel Margin="12,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentTitle}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding CurrentSubtitle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ToggleButton Style="{StaticResource ToggleIconButton}" Content="&#xE8B1;" ToolTip="Lecture aléatoire" AutomationProperties.Name="Lecture aléatoire"
                                      IsChecked="{Binding Shuffle}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Précédent" AutomationProperties.Name="Précédent" Command="{Binding PreviousCommand}" />
                        <Button Command="{Binding PlayPauseCommand}" Margin="10,0" ToolTip="Lecture / pause" AutomationProperties.Name="Lecture / pause">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PlayButton}">
                                    <Setter Property="Content" Value="&#xE768;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Content" Value="&#xE769;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Suivant" AutomationProperties.Name="Suivant" Command="{Binding NextCommand}" />
                        <Button Style="{StaticResource IconButton}" Content="{Binding RepeatIcon}" ToolTip="{Binding RepeatTooltip}"
                                Command="{Binding CycleRepeatCommand}" Margin="8,0,0,0">
                            <Button.Foreground>
                                <Binding Path="Repeat">
                                    <Binding.Converter>
                                        <conv:RepeatBrushConverter />
                                    </Binding.Converter>
                                </Binding>
                            </Button.Foreground>
                        </Button>
                    </StackPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position, Mode=OneWay}"
                                IsMoveToPointEnabled="True" VerticalAlignment="Center" IsEnabled="{Binding HasTrack}"
                                Thumb.DragStarted="SeekSlider_DragStarted" Thumb.DragCompleted="SeekSlider_DragCompleted"
                                PreviewMouseLeftButtonDown="SeekSlider_MouseDown" PreviewMouseLeftButtonUp="SeekSlider_MouseUp" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <views:SpectrumBars Width="64" Height="28" BarCount="12" Margin="0,0,10,0" Player="{Binding DataContext.Engine.Music, RelativeSource={RelativeSource AncestorType=Window}}"
                                        BarBrush="{DynamicResource BrandBrush}" Opacity="0.85" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE90B;" ToolTip="File d'attente" AutomationProperties.Name="File d'attente" Click="OnShowMusicPanel" Tag="queue" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BD;" ToolTip="Paroles" AutomationProperties.Name="Paroles" Click="OnShowMusicPanel" Tag="lyrics" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE9E9;" ToolTip="Effets musique (basses, nightcore, 8D, karaoké…)" AutomationProperties.Name="Effets musique (basses, nightcore, 8D, karaoké…)" Click="OnShowMusicPanel" Tag="effects" />
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center"
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid Margin="0,0,0,2">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" HorizontalAlignment="Left" FontSize="14" ToolTip="Volume de la musique" />
                        <Slider Margin="26,0,0,0" Minimum="0" Maximum="1" Value="{Binding Mix.MusicVolume}" IsMoveToPointEnabled="True" ToolTip="Volume de la musique" />
                    </Grid>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Mix.MediaToMicEnabled}" FontSize="12"
                              ToolTip="Désactivé : vous seul entendez la musique et les sons">
                        <TextBlock Text="Diffuser dans le micro" Style="{StaticResource Caption}" Foreground="{DynamicResource TextBrush}" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShareMediaWithDiscord}" FontSize="12" Margin="0,4,0,0"
                              ToolTip="Vos amis Discord entendent aussi la musique et les sons"
                              Visibility="{Binding Devices.HasDiscordOutput, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="…aussi sur Discord" Style="{StaticResource Caption}" Foreground="{DynamicResource TextBrush}" />
                    </CheckBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Toast ============ -->
        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20" Padding="16,12"
                CornerRadius="10" Background="{DynamicResource ToastBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" MaxWidth="420"
                Visibility="{Binding ToastMessage, Converter={StaticResource NullToVis}}" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding ToastMessage}" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>
        </Border>

        <!-- ============ Setup assistant ============ -->
        <views:SetupWizardView Grid.RowSpan="2" Grid.ColumnSpan="2" DataContext="{Binding Setup}"
                               Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />

        <!-- ============ Hotkey recording overlay ============ -->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#CC07080C"
              Visibility="{Binding IsRecordingHotkey, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" FontSize="38" Foreground="{DynamicResource Accent2Brush}" />
                    <TextBlock Text="Appuyez sur une touche, un bouton de souris ou de manette" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,6" />
                    <TextBlock Text="Combinaisons avec Ctrl / Maj / Alt acceptées. Boutons souris : molette, souris 4 et 5. Manettes, joysticks et HOTAS : tous les boutons et les chapeaux, même avec plusieurs appareils branchés."
                               Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RecordingTarget}" Style="{StaticResource ValueText}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="Échap : annuler   ·   Suppr : effacer le raccourci" Style="{StaticResource Caption}"
                               TextAlignment="Center" Margin="0,14,0,16" />
                    <Button Content="Annuler" Style="{StaticResource FlatButton}" HorizontalAlignment="Center"
                            Command="{Binding CancelRecordingCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
