<UserControl x:Class="SpokaSoundBoard.Views.MixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpokaSoundBoard.Views">
    <!-- DataContext: MainViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="Mixage &amp; ducking" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"
                       Text="Réglez l'équilibre entre votre voix, la musique et les sons. Le ducking baisse automatiquement la musique quand vous parlez pour que votre voix passe par-dessus." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" Foreground="{StaticResource Accent2Brush}" Margin="0,0,10,0" />
                        <TextBlock Text="Qui entend quoi ?" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                               Text="Choisissez ce que les joueurs en jeu et vos amis Discord entendent. Exemple : la musique et l'effet pilote pour les passagers de l'hélico, mais seulement votre voix normale sur Discord." />
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Jeu" FontWeight="SemiBold" />
                            </StackPanel>
                            <ProgressBar Style="{StaticResource Meter}" Height="4" Width="90" Margin="0,6,0,0" Value="{Binding OutputLevel, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Discord" FontWeight="SemiBold" />
                            </StackPanel>
                            <ProgressBar Style="{StaticResource Meter}" Height="4" Width="90" Margin="0,6,0,0" Value="{Binding DiscordLevel, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ma voix" Style="{StaticResource Label}" />
                                <TextBlock Text="Votre micro" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Center" IsChecked="{Binding Mix.GameVoice}" />
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Center" IsChecked="{Binding Mix.DiscordVoice}"
                                      IsEnabled="{Binding Devices.HasDiscordOutput}" />
                        </Grid>
                    </Border>
                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Effets sur ma voix" Style="{StaticResource Label}" />
                                <TextBlock Text="Désactivé : voix naturelle (le mode radio ne s'applique pas)" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Center" IsChecked="{Binding Mix.GameVoiceEffects}" />
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Center" IsChecked="{Binding Mix.DiscordVoiceEffects}"
                                      IsEnabled="{Binding Devices.HasDiscordOutput}" />
                        </Grid>
                    </Border>
                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Musique" Style="{StaticResource Label}" />
                                <TextBlock Text="Le lecteur de musique" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Center" IsChecked="{Binding Mix.GameMusic}" />
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Center" IsChecked="{Binding Mix.DiscordMusic}"
                                      IsEnabled="{Binding Devices.HasDiscordOutput}" />
                        </Grid>
                    </Border>
                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sons de la soundboard" Style="{StaticResource Label}" />
                                <TextBlock Text="Les sons des tuiles" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Center" IsChecked="{Binding Mix.GameSounds}" />
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Center" IsChecked="{Binding Mix.DiscordSounds}"
                                      IsEnabled="{Binding Devices.HasDiscordOutput}" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="6" Padding="12,8" Margin="0,6,0,0"
                            Visibility="{Binding Devices.HasDiscordOutput, Converter={StaticResource InverseBoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Configurer" Padding="10,4" Margin="10,0,0,0"
                                    Command="{Binding NavigateCommand}" CommandParameter="settings" />
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"
                                       Text="La colonne Discord nécessite un 2e micro virtuel (gratuit). Sans lui, choisissez votre vrai micro dans Discord : vos amis n'entendront que votre voix naturelle." />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Mix.DuckingEnabled}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" Foreground="{StaticResource Accent2Brush}" Margin="0,0,10,0" />
                                    <TextBlock Text="Ducking automatique" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                       Text="Quand votre voix dépasse le seuil, la musique et les sons baissent, puis remontent doucement quand vous vous taisez." />

                            <local:ThresholdMeter Margin="0,0,0,10" />

                            <StackPanel IsEnabled="{Binding Mix.DuckingEnabled}">
                                <Grid Margin="0,4,0,4">
                                    <TextBlock Text="Réduction actuelle" Style="{StaticResource Label}" />
                                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding DuckReductionDb, Converter={StaticResource Db}}" />
                                </Grid>
                                <local:SliderRow Label="Baisse de la musique quand vous parlez" Minimum="-40" Maximum="0" Step="1" Format="dB"
                                                 Value="{Binding Mix.DuckingAmountDb}" Description="-6 dB = léger · -14 dB = recommandé · -30 dB = presque coupée" />
                                <local:SliderRow Label="Vitesse de baisse" Minimum="10" Maximum="500" Step="10" Format="{}{0:0} ms"
                                                 Value="{Binding Mix.DuckingAttackMs}" />
                                <local:SliderRow Label="Vitesse de remontée" Minimum="100" Maximum="3000" Step="50" Format="{}{0:0} ms"
                                                 Value="{Binding Mix.DuckingReleaseMs}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Mix.PushToTalkEnabled}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE709;" Foreground="{StaticResource Accent2Brush}" Margin="0,0,10,0" />
                                    <TextBlock Text="Mode radio (appuyer pour parler)" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                       Text="Comme une vraie radio de pilote : votre voix ne passe que lorsque vous maintenez la touche, avec le grésillement au début et à la fin. La musique continue de jouer." />
                            <TextBlock Text="Touche radio" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Effacer"
                                        Command="{Binding ClearHotkeyCommand}" CommandParameter="{Binding HotkeySettings.PushToTalk}" />
                                <Button Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"
                                        Command="{Binding RecordHotkeyCommand}" CommandParameter="{Binding HotkeySettings.PushToTalk}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" FontSize="14" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding HotkeySettings.PushToTalk.Display}" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Mix.PushToTalkEnabled}" Value="True" />
                                                    <Condition Binding="{Binding HotkeySettings.PushToTalk.IsSet}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}"
                                           Text="Définissez une touche radio, sinon votre voix ne passera jamais." />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" Foreground="{StaticResource Accent2Brush}" Margin="0,0,10,0" />
                                <TextBlock Text="Volumes" Style="{StaticResource SectionTitle}" />
                            </StackPanel>
                            <local:SliderRow Label="Musique (lecteur)" Minimum="0" Maximum="1.5" Format="%" Value="{Binding Mix.MusicVolume}" />
                            <local:SliderRow Label="Sons de la soundboard" Minimum="0" Maximum="1.5" Format="%" Value="{Binding Mix.PadsVolume}" />
                            <local:SliderRow Label="Musique &amp; sons envoyés aux autres" Minimum="0" Maximum="1.5" Format="%"
                                             Value="{Binding Mix.MediaToMicVolume}" Description="Niveau de la musique dans votre micro (ce que vos amis entendent)." />
                            <local:SliderRow Label="Retour dans votre casque" Minimum="0" Maximum="1.5" Format="%"
                                             Value="{Binding Mix.MonitorVolume}" Description="Ce que vous entendez vous-même." />
                            <local:SliderRow Label="Votre voix" Minimum="-24" Maximum="12" Step="0.5" Format="dB" Value="{Binding VoiceSettings.VoiceVolumeDb}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Foreground="{StaticResource Accent2Brush}" Margin="0,0,10,0" />
                                <TextBlock Text="Routage" Style="{StaticResource SectionTitle}" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Mix.MicEnabled}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Envoyer ma voix" Style="{StaticResource Label}" />
                                    <TextBlock Text="Désactivez pour couper votre voix tout en gardant la musique" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Mix.MediaToMicEnabled}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Envoyer la musique et les sons" Style="{StaticResource Label}" />
                                    <TextBlock Text="Désactivez pour écouter seul (pré-écoute)" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Mix.ListenToSelf}">
                                <StackPanel>
                                    <TextBlock Text="M'écouter dans le casque" Style="{StaticResource Label}" />
                                    <TextBlock Text="Pour tester vos effets (avec un casque uniquement)" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
