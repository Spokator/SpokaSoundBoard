<UserControl x:Class="SpokaSoundBoard.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpokaSoundBoard.Views"
             xmlns:models="clr-namespace:SpokaSoundBoard.Core.Models;assembly=SpokaSoundBoard.Core">
    <!-- DataContext: MainViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="Configuration" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"
                       Text="Choisissez vos périphériques audio, installez le micro virtuel et définissez vos raccourcis." />

            <!-- Virtual cable -->
            <Border Style="{StaticResource Card}" DataContext="{Binding Devices}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F5;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                        <TextBlock Text="Micro virtuel" Style="{StaticResource SectionTitle}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasVirtualCable, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding VirtualCableStatus}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap">
                            <Run Text="Dans Discord et dans vos jeux, choisissez comme micro :" />
                            <Run Text="{Binding VirtualMicName, Mode=OneWay}" Foreground="{DynamicResource Accent2Brush}" FontWeight="SemiBold" />
                        </TextBlock>

                        <!-- Spoka Cable installed after the user set things up with another cable. -->
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
                                Visibility="{Binding SpokaCableUnused, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Utiliser Spoka Cable"
                                        Command="{Binding UseSpokaCableCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <StackPanel>
                                    <TextBlock Text="Spoka Cable est installé" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="Notre propre câble virtuel : le son passe sans conversion ni coupure. Pensez ensuite à changer le micro dans Discord et dans vos jeux." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasVirtualCable, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,0,0,12"
                                   Text="Pour que les autres entendent votre musique et vos effets, SpokaSoundBoard a besoin d'un « câble audio virtuel ». VB-CABLE est gratuit et officiel. Il crée un faux micro « CABLE Output » que vous choisirez dans Discord ou dans vos jeux. L'installation demande les droits administrateur et un redémarrage du PC." />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}" Command="{Binding InstallVbCableCommand}" Margin="0,0,10,0"
                                    IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding InstallVbCableLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Content="Site officiel" Command="{Binding OpenVbCableSiteCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource FlatButton}" Command="{Binding RefreshCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Actualiser" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource Caption}" Foreground="{DynamicResource Accent2Brush}" Margin="0,10,0,0"
                                   Visibility="{Binding InstallStatus, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Second virtual cable (Discord) -->
            <Border Style="{StaticResource Card}" DataContext="{Binding Devices}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                        <TextBlock Text="Séparer Discord du jeu (optionnel)" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,0,0,12"
                               Text="Pour que les joueurs en jeu entendent votre musique et vos effets sans que vos amis Discord les entendent (ou l'inverse), il faut un 2e micro virtuel. Virtual Audio Cable Lite est gratuit pour un usage personnel et fonctionne à côté de VB-CABLE. Réglez ensuite qui entend quoi dans « Mixage &amp; ducking »." />

                    <StackPanel Visibility="{Binding HasSecondCable, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Deuxième micro virtuel détecté." Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" FontSize="13">
                            <Run Text="Dans Discord, choisissez comme micro :" />
                            <Run Text="{Binding DiscordMicName, Mode=OneWay}" Foreground="{DynamicResource Accent2Brush}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasSecondCable, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}" Command="{Binding InstallSecondCableCommand}" Margin="0,0,10,0"
                                    IsEnabled="{Binding IsInstallingSecond, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding InstallVacLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Content="Site officiel" Command="{Binding OpenVacSiteCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource FlatButton}" Command="{Binding RefreshCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Actualiser" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding SecondInstallStatus}" Style="{StaticResource Caption}" Foreground="{DynamicResource Accent2Brush}" Margin="0,10,0,0"
                                   Visibility="{Binding SecondInstallStatus, Converter={StaticResource NullToVis}}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="Sans 2e câble : choisissez simplement votre vrai micro dans Discord. Vos amis entendront votre voix naturelle, sans musique ni effets." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Devices -->
            <Border Style="{StaticResource Card}" DataContext="{Binding Devices}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Command="{Binding RefreshCommand}" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Actualiser" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F6;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                            <TextBlock Text="Périphériques audio" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Votre vrai micro" Style="{StaticResource Label}" />
                            <TextBlock Text="Le micro dans lequel vous parlez" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedMic}" DisplayMemberPath="Name" Margin="0,4" />
                        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="10,6" Margin="0,4,0,4"
                                Visibility="{Binding MicIsVirtualWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}"
                                       Text="Attention : vous avez choisi un micro virtuel comme source. Choisissez votre vrai micro (casque, micro USB…), sinon le son va boucler." />
                        </Border>

                        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="Sortie Jeu (micro virtuel)" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding VirtualOutputHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedVirtualOutput}"
                                  DisplayMemberPath="Name" Margin="0,14,0,4" />
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="6,10,0,0"
                                ToolTip="Aucune" Command="{Binding ClearVirtualOutputCommand}" />
                        <Border Grid.Row="3" Grid.ColumnSpan="3" Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="10,6" Margin="0,4,0,4"
                                Visibility="{Binding VirtualOutputWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}"
                                       Text="Cette sortie n'est pas un câble virtuel : votre voix et la musique sortiront dans ces haut-parleurs au lieu d'aller dans le micro virtuel." />
                        </Border>

                        <StackPanel Grid.Row="4" VerticalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="Sortie Discord (optionnel)" Style="{StaticResource Label}" />
                            <TextBlock Text="2e micro virtuel, ex. « Line 1 »" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedDiscordOutput}"
                                  DisplayMemberPath="Name" Margin="0,14,0,4" />
                        <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="6,10,0,0"
                                ToolTip="Aucune" Command="{Binding ClearDiscordOutputCommand}" />
                        <Border Grid.Row="5" Grid.ColumnSpan="3" Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="10,6" Margin="0,4,0,4"
                                Visibility="{Binding DiscordSameCableWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}"
                                       Text="Discord et le jeu utilisent le même câble : ils entendront exactement la même chose. Choisissez un autre câble virtuel pour Discord." />
                        </Border>

                        <StackPanel Grid.Row="6" VerticalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="Retour casque" Style="{StaticResource Label}" />
                            <TextBlock Text="Où vous entendez la musique vous-même" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedMonitor}"
                                  DisplayMemberPath="Name" Margin="0,14,0,4" />
                        <Button Grid.Row="6" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="6,10,0,0"
                                ToolTip="Aucun" Command="{Binding ClearMonitorCommand}" />
                    </Grid>
                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="10,5"
                            Command="{Binding OpenWindowsSoundSettingsCommand}">
                        <TextBlock Text="Ouvrir les paramètres son de Windows" FontSize="12" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Hotkeys -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                        <TextBlock Text="Raccourcis globaux" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                               Text="Fonctionnent même quand vous êtes en jeu. Touches du clavier, boutons de souris, et boutons de manette, joystick ou HOTAS (chapeaux compris). La touche n'est pas bloquée : le jeu la reçoit aussi. Les raccourcis des sons se règlent sur chaque son de la soundboard." />
                    <ItemsControl x:Name="HotkeyList" ItemsSource="{Binding Devices.HotkeyRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.RecordHotkeyCommand, ElementName=HotkeyList}" CommandParameter="{Binding Binding}">
                                        <DockPanel ToolTip="{Binding Binding.Display}">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Binding.Glyph}" FontSize="13" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Binding.Display}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="6,0,0,0" ToolTip="Effacer"
                                            Command="{Binding DataContext.ClearHotkeyCommand, ElementName=HotkeyList}" CommandParameter="{Binding Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Game profiles -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                        <TextBlock Text="Profils par jeu" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Quand un jeu se lance, SpokaSoundBoard passe tout seul sur ses réglages : son effet de voix, son onglet de sons, le mode radio… Quelques secondes après sa fermeture, vos réglages d'avant reviennent, sauf ceux que vous avez changés vous-même entre-temps." />
                    <TextBlock Text="{Binding ActiveProfileText}" Style="{StaticResource Label}" Foreground="{DynamicResource Accent2Brush}" Margin="0,8,0,0"
                               Visibility="{Binding HasGameProfiles, Converter={StaticResource BoolToVis}}" />

                    <ItemsControl ItemsSource="{Binding GameProfiles}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SubCardBrush}" CornerRadius="8" Padding="12,10" Margin="0,6,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Supprimer ce profil"
                                                    AutomationProperties.Name="Supprimer ce profil"
                                                    Command="{Binding DataContext.RemoveProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <CheckBox DockPanel.Dock="Left" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                      ToolTip="Profil actif ou en pause" AutomationProperties.Name="Profil activé" Margin="0,0,10,0" />
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0">
                                                <Run Text="{Binding ProcessName, Mode=OneWay}" /><Run Text=".exe" />
                                            </TextBlock>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinWidth="160" VerticalAlignment="Center"
                                                     AutomationProperties.Name="Nom du profil" />
                                        </DockPanel>
                                        <WrapPanel Margin="0,8,0,0">
                                            <StackPanel Margin="0,0,12,6" Width="170">
                                                <TextBlock Text="Effet de voix" Style="{StaticResource Caption}" />
                                                <ComboBox ItemsSource="{Binding DataContext.ProfilePresetChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding Preset, Converter={StaticResource KeepChoice}}" AutomationProperties.Name="Effet de voix du profil" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6" Width="150">
                                                <TextBlock Text="Onglet de sons" Style="{StaticResource Caption}" />
                                                <ComboBox ItemsSource="{Binding DataContext.ProfileCategoryChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding Category, Converter={StaticResource KeepChoice}}" AutomationProperties.Name="Onglet de sons du profil" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6" Width="150">
                                                <TextBlock Text="Effets de voix" Style="{StaticResource Caption}" />
                                                <ComboBox SelectedIndex="{Binding Effects, Converter={StaticResource NullableBoolIndex}}" AutomationProperties.Name="Effets de voix pendant le jeu">
                                                    <ComboBoxItem Content="Ne pas changer" /><ComboBoxItem Content="Activer" /><ComboBoxItem Content="Couper" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6" Width="150">
                                                <TextBlock Text="Mode radio" Style="{StaticResource Caption}" />
                                                <ComboBox SelectedIndex="{Binding Radio, Converter={StaticResource NullableBoolIndex}}" AutomationProperties.Name="Mode radio pendant le jeu">
                                                    <ComboBoxItem Content="Ne pas changer" /><ComboBoxItem Content="Activer" /><ComboBoxItem Content="Désactiver" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6" Width="150">
                                                <TextBlock Text="Anti-bruit" Style="{StaticResource Caption}" />
                                                <ComboBox SelectedIndex="{Binding NoiseSuppression, Converter={StaticResource NullableBoolIndex}}" AutomationProperties.Name="Anti-bruit pendant le jeu">
                                                    <ComboBoxItem Content="Ne pas changer" /><ComboBoxItem Content="Activer" /><ComboBoxItem Content="Désactiver" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6" Width="170">
                                                <TextBlock Text="Musique dans le micro" Style="{StaticResource Caption}" />
                                                <ComboBox SelectedIndex="{Binding MediaToMic, Converter={StaticResource NullableBoolIndex}}" AutomationProperties.Name="Musique dans le micro pendant le jeu">
                                                    <ComboBoxItem Content="Ne pas changer" /><ComboBoxItem Content="Partager" /><ComboBoxItem Content="Pour moi seul" />
                                                </ComboBox>
                                            </StackPanel>
                                        </WrapPanel>
                                        <CheckBox IsChecked="{Binding OnlyWhenForeground}" Margin="0,4,0,0"
                                                  Content="Seulement quand le jeu est la fenêtre au premier plan (sinon : tant qu'il est ouvert)" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource FlatButton}" Margin="0,0,8,0" Click="OnAddRunningGameClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Ajouter un jeu ouvert…" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Command="{Binding AddGameProgramCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Choisir le programme du jeu…" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Guide -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                        <TextBlock Text="Guide de configuration" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock Text="Discord" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,0,0,12" LineHeight="21">
                        1. Paramètres utilisateur → Voix et vidéo → Périphérique d'entrée : <Run Text="{Binding Devices.GuideMicName, Mode=OneWay}" Foreground="{DynamicResource Accent2Brush}" />
                        (ou <Run Text="{Binding Devices.GuideDiscordMicName, Mode=OneWay}" Foreground="{DynamicResource Accent2Brush}" /> si vous avez séparé Discord du jeu)<LineBreak />
                        2. Traitement de la voix : Suppression du bruit = <Bold>Aucune</Bold>, et désactivez Annulation de l'écho, Activité vocale avancée et Contrôle automatique du gain. Ces filtres prennent la musique pour du bruit et la coupent. Pour enlever le bruit de votre micro, utilisez plutôt la suppression du bruit de SpokaSoundBoard (Voix &amp; effets) : elle ne touche qu'à votre voix.<LineBreak />
                        3. Sensibilité d'entrée : désactivez « Déterminer automatiquement » et mettez le curseur <Bold>tout à gauche</Bold>, sinon Discord coupe le micro dans les passages calmes.<LineBreak />
                        4. Atténuation (en bas de la page) : mettez-la à <Bold>0 %</Bold>. SpokaSoundBoard rétablit aussi automatiquement le volume si Discord ou Windows le baissent.<LineBreak />
                        5. Astuce : « Qualité de la voix » au maximum dans les serveurs que vous gérez pour une musique plus claire.
                    </TextBlock>
                    <TextBlock Text="Jeux (hélico, simulateurs, FiveM, Arma, DCS…)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" LineHeight="21">
                        1. Dans les options audio du jeu, choisissez <Run Text="{Binding Devices.GuideMicName, Mode=OneWay}" Foreground="{DynamicResource Accent2Brush}" /> comme micro.<LineBreak />
                        2. Si le jeu ne propose pas de choix, définissez ce micro comme micro par défaut dans les paramètres son de Windows.<LineBreak />
                        3. Gardez la touche « parler » du jeu : SpokaSoundBoard envoie la musique en continu, le jeu décide quand transmettre.<LineBreak />
                        4. Pour un effet pilote : preset « Pilote d'hélico » + mode radio avec la même touche que le push-to-talk du jeu.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" DataContext="{Binding Appearance}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Par défaut" Padding="10,5" FontSize="12"
                                Command="{Binding ResetCommand}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                            <TextBlock Text="Apparence" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Thème" Style="{StaticResource Label}" />
                        <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Settings.Theme}" Margin="0,4">
                            <ComboBoxItem Content="Sombre" Tag="{x:Static models:AppTheme.Dark}" />
                            <ComboBoxItem Content="Noir profond (écrans OLED)" Tag="{x:Static models:AppTheme.Oled}" />
                            <ComboBoxItem Content="Clair" Tag="{x:Static models:AppTheme.Light}" />
                        </ComboBox>

                        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,16,0,0">
                            <TextBlock Text="Couleur principale" Style="{StaticResource Label}" />
                            <TextBlock Text="Boutons, sélection, dégradés" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                            <ItemsControl ItemsSource="{Binding Accents}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="34" Height="34" Margin="0,0,8,8" Cursor="Hand" ToolTip="{Binding Name}"
                                                Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" />
                                                        <Ellipse Margin="4">
                                                            <Ellipse.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Offset="0" Color="{Binding Accent}" />
                                                                    <GradientStop Offset="1" Color="{Binding Secondary}" />
                                                                </LinearGradientBrush>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,2,0,0">
                                <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0"
                                        Background="{DynamicResource AccentBrush}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Appliquer" Margin="8,0,0,0"
                                        Command="{Binding ApplyCustomColorCommand}" />
                                <TextBox Text="{Binding CustomColor, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                         ToolTip="Couleur personnalisée au format #RRGGBB" />
                            </DockPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Taille de l'interface" Style="{StaticResource Label}" Margin="0,16,0,0" VerticalAlignment="Top" />
                        <local:SliderRow Grid.Row="2" Grid.Column="1" Label="Zoom" Minimum="0.8" Maximum="1.4" Step="0.05" Format="%"
                                         Value="{Binding Settings.UiScale}" Margin="0,10,0,0" />

                        <TextBlock Grid.Row="3" Text="Taille des tuiles de sons" Style="{StaticResource Label}" Margin="0,16,0,0" />
                        <ComboBox Grid.Row="3" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Settings.PadSize}" Margin="0,14,0,4">
                            <ComboBoxItem Content="Petites (plus de sons à l'écran)" Tag="{x:Static models:PadSize.Small}" />
                            <ComboBoxItem Content="Normales" Tag="{x:Static models:PadSize.Medium}" />
                            <ComboBoxItem Content="Grandes" Tag="{x:Static models:PadSize.Large}" />
                        </ComboBox>

                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,16,0,0">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowSidebarMeters}" Margin="0,0,0,10">
                                <TextBlock Text="Afficher les vumètres dans la barre latérale" Style="{StaticResource Label}" />
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowPadHotkeys}">
                                <TextBlock Text="Afficher les raccourcis sur les tuiles de sons" Style="{StaticResource Label}" />
                            </CheckBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE770;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                        <TextBlock Text="Application" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CloseToTray}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="La croix réduit dans la zone de notification" Style="{StaticResource Label}" />
                            <TextBlock Text="L'application continue (musique, raccourcis) avec une icône près de l'horloge. Clic droit sur l'icône → Quitter pour fermer." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Autostart}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Lancer au démarrage de Windows" Style="{StaticResource Label}" />
                            <TextBlock Text="Démarre discrètement dans la zone de notification" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Command="{Binding OpenSetupCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE82F;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Relancer l'assistant de configuration" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                        <TextBlock Text="Mises à jour" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <!-- Store edition: no GitHub check, the Store installs updates. -->
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsStoreEdition, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Mises à jour automatiques par le Microsoft Store" Style="{StaticResource Label}" />
                        <TextBlock Text="Windows installe les nouvelles versions tout seul (Microsoft Store → Bibliothèque pour forcer la recherche)." Style="{StaticResource Caption}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CheckForUpdates}" Margin="0,0,0,12"
                              Visibility="{Binding IsStoreEdition, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Vérifier les mises à jour au démarrage" Style="{StaticResource Label}" />
                            <TextBlock Text="Les nouvelles versions sont publiées sur GitHub et s'installent en un clic." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource FlatButton}" Content="Vérifier maintenant" Command="{Binding CheckForUpdateNowCommand}" Margin="0,0,12,0"
                                Visibility="{Binding IsStoreEdition, Converter={StaticResource InverseBoolToVis}}" />
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                            <Run Text="Version installée :" />
                            <Run Text="{Binding CurrentVersion, Mode=OneWay}" Foreground="{DynamicResource Accent2Brush}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                        <TextBlock Text="Télécommande" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Votre téléphone devient un Stream Deck : votre deck de boutons favoris, toute la soundboard, le micro et les effets de voix, « maintenir pour parler », une phrase à dire dans le micro, la musique et ses volumes, et l'animation du blind test (la réponse s'affiche sur le téléphone, pas à l'écran). Marche aussi avec un Stream Deck, Touch Portal ou OBS. Chaque adresse contient un code d'accès : ne la partagez pas." />
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RemoteSettings.Enabled}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Activer la télécommande" Style="{StaticResource Label}" />
                            <TextBlock Text="Accessible depuis ce PC (Stream Deck, Touch Portal, OBS…)" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RemoteSettings.AllowNetwork}" Margin="0,0,0,8"
                              IsEnabled="{Binding RemoteSettings.Enabled}">
                        <StackPanel>
                            <TextBlock Text="Depuis mon téléphone" Style="{StaticResource Label}" />
                            <TextBlock Text="Ouvre la télécommande aux appareils de votre réseau local (même Wi-Fi). À activer seulement sur le réseau de la maison." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Text="{Binding RemoteStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding RemoteClientsText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <Grid Visibility="{Binding RemoteSettings.Enabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Adresse sur ce PC" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Ouvrir" Padding="10,5" Margin="6,0,0,0"
                                        Command="{Binding OpenRemotePageCommand}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Copier" Padding="10,5" Margin="6,0,0,0"
                                        Command="{Binding CopyTextCommand}" CommandParameter="{Binding RemoteLocalUrl}" />
                                <TextBox Text="{Binding RemoteLocalUrl, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="Adresse de la télécommande sur ce PC" />
                            </DockPanel>
                            <StackPanel Visibility="{Binding HasRemoteNetworkUrl, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Adresse pour le téléphone" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Copier" Padding="10,5" Margin="6,0,0,0"
                                            Command="{Binding CopyTextCommand}" CommandParameter="{Binding RemoteNetworkUrl}" />
                                    <TextBox Text="{Binding RemoteNetworkUrl, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Adresse de la télécommande pour le téléphone" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Port" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="80" Text="{Binding RemoteSettings.Port, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Port de la télécommande" />
                                <Button Style="{StaticResource FlatButton}" Content="Nouveau code d'accès" Padding="10,5" Margin="12,0,0,0"
                                        Command="{Binding NewRemoteCodeCommand}" ToolTip="Les anciennes adresses (et le QR code) cessent de fonctionner" />
                            </StackPanel>
                            <Expander Header="Utiliser avec un Stream Deck, Touch Portal ou OBS" Foreground="{DynamicResource TextBrush}">
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas">
                                    <Run Text="Ajoutez une action « ouvrir une adresse » ou « requête HTTP » (GET ou POST) : l'adresse sur ce PC, en remplaçant « /? » par l'un de ces chemins, puis le code : « ?code=… » (ou « &amp;code=… » si le chemin contient déjà un « ? ») :" FontFamily="Segoe UI" />
                                    <LineBreak /><LineBreak />
                                    <Run Text="/api/pads/NOM DU SON/play" /><Run Text="  jouer un son (son nom exact)" FontFamily="Segoe UI" /><LineBreak />
                                    <Run Text="/api/presets/NOM DE L'EFFET/apply" /><Run Text="  appliquer un effet de voix" FontFamily="Segoe UI" /><LineBreak />
                                    <Run Text="/api/action/stop · mic · effects · radio · noise" /><Run Text="  tout arrêter, micro, effets, mode radio, suppression du bruit" FontFamily="Segoe UI" /><LineBreak />
                                    <Run Text="/api/action/preset-next · preset-previous" /><Run Text="  effet suivant / précédent" FontFamily="Segoe UI" /><LineBreak />
                                    <Run Text="/api/action/music-playpause · music-next · music-previous · media-to-mic" /><Run Text="  musique" FontFamily="Segoe UI" /><LineBreak />
                                    <Run Text="/api/action/music-volume-up · music-volume-down" /><Run Text="  volume de la musique (par 5 %)" FontFamily="Segoe UI" /><LineBreak />
                                    <Run Text="/api/action/live-voice" /><Run Text="  parler avec la voix de synthèse (on/off)" FontFamily="Segoe UI" /><LineBreak />
                                    <Run Text="/api/action/bt-reveal · bt-next · bt-replay · bt-pause · bt-hint · bt-skip" /><Run Text="  blind test" FontFamily="Segoe UI" /><LineBreak />
                                    <Run Text="/api/say?text=Bonjour" /><Run Text="  dire une phrase dans le micro" FontFamily="Segoe UI" /><LineBreak />
                                    <Run Text="/api/mix?key=music&amp;value=0.8" /><Run Text="  volume (music, pads, tomic, monitor ; 0 à 1,5)" FontFamily="Segoe UI" /><LineBreak />
                                    <Run Text="/api/catalog, /api/state" /><Run Text="  sons, effets et état complet (JSON)" FontFamily="Segoe UI" />
                                </TextBlock>
                            </Expander>
                        </StackPanel>
                        <Border Grid.Column="1" Margin="16,0,0,0" Background="White" CornerRadius="8" Padding="6" VerticalAlignment="Top"
                                Visibility="{Binding HasRemoteNetworkUrl, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding RemoteQrCode}" Width="160" Height="160" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   AutomationProperties.Name="QR code de la télécommande pour le téléphone" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                        <TextBlock Text="Stockage" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StorageText}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReleasableText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Les fichiers que plus aucun son ni morceau n'utilise sont supprimés automatiquement après deux jours." />
                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding FreeMusicSpaceCommand}"
                            IsEnabled="{Binding CanFreeMusicSpace}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Libérer l'espace des musiques" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                        <TextBlock Text="Sauvegarde complète" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                               Text="Tout SpokaSoundBoard dans un seul fichier, pour changer de PC, passer de la version installeur à celle du Microsoft Store (ou l'inverse), ou garder une copie de sécurité." />
                    <TextBlock Text="{Binding BackupSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <CheckBox Content="{Binding BackupMusicText}" IsChecked="{Binding BackupIncludeMusic}" Margin="0,10,0,0"
                              ToolTip="Sans cette case, les musiques venues d'Internet se téléchargent à nouveau quand vous les écoutez ; vos fichiers personnels restent là où ils sont." />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource AccentButton}" Margin="0,0,8,8" Command="{Binding CreateBackupCommand}" IsEnabled="{Binding BackupBusy, Converter={StaticResource InverseBool}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Créer une sauvegarde…" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Margin="0,0,8,8" Command="{Binding RestoreBackupCommand}" IsEnabled="{Binding BackupBusy, Converter={StaticResource InverseBool}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Restaurer une sauvegarde…" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <ProgressBar Height="4" Maximum="1" Value="{Binding BackupProgress}" Margin="0,2,0,0"
                                 Visibility="{Binding BackupBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                        <TextBlock Text="Diagnostic audio" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                               Text="Si le son coupe chez vos amis, regardez ces compteurs (remis à zéro à chaque redémarrage de l'audio). Ils restent à 0 si tout va bien côté SpokaSoundBoard : une coupure vient alors des réglages de Discord." />
                    <TextBox Text="{Binding DiagnosticsText, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0"
                             AutomationProperties.Name="Compteurs de diagnostic audio" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                        <TextBlock Text="Aide et signalement" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Un problème ? Copiez le rapport de diagnostic (versions, périphériques, compteurs audio, dernières erreurs) et collez-le dans votre signalement. Rien n'est envoyé automatiquement." />
                    <WrapPanel>
                        <Button Style="{StaticResource FlatButton}" Margin="0,0,8,8" Command="{Binding CopyDiagnosticsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Copier le rapport de diagnostic" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Margin="0,0,8,8" Command="{Binding ReportProblemCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEBE8;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Signaler un problème" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Margin="0,0,8,8" Command="{Binding OpenDataFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Ouvrir le dossier des réglages" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="À propos" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="SpokaSoundBoard — soundboard, lecteur de musique, liens YouTube et effets de voix en temps réel." />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                        <Run Text="Version" />
                        <Run Text="{Binding CurrentVersion, Mode=OneWay}" Foreground="{DynamicResource Accent2Brush}" />
                        <Run Text="· édition" />
                        <Run Text="{Binding EditionName, Mode=OneWay}" Foreground="{DynamicResource Accent2Brush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding SettingsLocationText}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Aucun compte, aucune télémétrie : rien ne nous est envoyé. L'application contacte seulement les sites des fonctions en ligne que vous utilisez (recherche, imports, paroles, voix naturelles) et, pour la version installeur, GitHub pour les mises à jour." />
                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding OpenPrivacyPolicyCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Politique de confidentialité" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
