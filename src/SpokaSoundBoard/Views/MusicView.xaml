<UserControl x:Class="SpokaSoundBoard.Views.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpokaSoundBoard.Views"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Background="Transparent">
    <DockPanel Margin="28,24,28,0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource FlatButton}" Command="{Binding ClearPlaylistCommand}" Margin="0,0,10,0" ToolTip="Vider la liste">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource FlatButton}" Command="{Binding Link.ToggleCommand}" Margin="0,0,10,0"
                        ToolTip="Rechercher une musique sur YouTube ou coller un lien. Vous pouvez aussi glisser un lien depuis votre navigateur.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Rechercher / lien" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Command="{Binding AddFolderCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Ajouter un dossier" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Command="{Binding AddFilesCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Ajouter des musiques" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Musique" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Votre playlist diffusée dans le micro. Double-cliquez sur un morceau pour le lancer. Quand vous parlez, la musique baisse automatiquement." />
            </StackPanel>
        </DockPanel>

        <local:LinkBar DockPanel.Dock="Top" DataContext="{Binding Link}" />

        <Grid>
            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="2" CornerRadius="14" Margin="0,0,0,24"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="54" Foreground="{StaticResource Accent2Brush}" />
                    <TextBlock Text="Aucune musique" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                    <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" FontSize="13"
                               Text="Glissez-déposez des fichiers, des dossiers ou un lien YouTube depuis votre navigateur, ou utilisez les boutons en haut à droite." />
                </StackPanel>
            </Border>

            <ListBox x:Name="TrackList" ItemsSource="{Binding Playlist}" SelectedItem="{Binding SelectedTrack}"
                     Background="Transparent" BorderThickness="0" Margin="0,0,0,16" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnTrackDoubleClick"
                     KeyDown="OnTrackKeyDown"
                     Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="6" Background="#262B3B">
                                <TextBlock Text="&#xE8D6;" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Text" Value="&#xE995;" />
                                                    <Setter Property="Foreground" Value="{StaticResource Accent2Brush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent2Brush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="10" Margin="0,0,5,0" Foreground="{StaticResource SubtleTextBrush}"
                                               Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Folder}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="13" ToolTip="Lire"
                                        Command="{Binding DataContext.PlayTrackCommand, ElementName=TrackList}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" FontSize="13" ToolTip="Ouvrir la source"
                                        Command="{Binding DataContext.Link.OpenSourceCommand, ElementName=TrackList}" CommandParameter="{Binding SourceUrl}"
                                        Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="13" ToolTip="Retirer de la liste"
                                        Command="{Binding DataContext.RemoveTrackCommand, ElementName=TrackList}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
