<UserControl x:Class="SpokaSoundBoard.Views.LinkBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: LinkImporter -->
    <Border Style="{StaticResource Card}" Padding="16" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Fermer"
                        Command="{Binding ToggleCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Annuler" Margin="8,0,0,0"
                        Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Command="{Binding ImportCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Importer" />
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE71B;" Foreground="{StaticResource Accent2Brush}" Margin="0,0,12,0" />
                <Grid>
                    <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" KeyDown="OnUrlKeyDown" />
                    <TextBlock Text="{Binding Placeholder}" Margin="12,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Url}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ImportPlaylist}" Margin="30,10,0,0" HorizontalAlignment="Left"
                      Visibility="{Binding SupportsPlaylist, Converter={StaticResource BoolToVis}}"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                <TextBlock Text="Importer toute la playlist (jusqu'à 200 morceaux)" Style="{StaticResource Caption}" Foreground="{StaticResource TextBrush}" />
            </CheckBox>

            <ProgressBar Style="{StaticResource Meter}" Height="6" Margin="30,12,0,0" Maximum="100"
                         Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"
                         Foreground="{StaticResource BrandBrush}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="{Binding Status}" Margin="30,8,0,0" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding Status, Converter={StaticResource NullToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Style="{StaticResource Caption}" Margin="30,6,0,0" FontSize="11"
                       Text="YouTube, SoundCloud, MyInstants, TikTok, Twitch, liens MP3 directs… L'audio est enregistré sur votre PC pour une lecture instantanée. Respectez les droits des contenus que vous diffusez." />
        </StackPanel>
    </Border>
</UserControl>
