<UserControl x:Class="SpokaSoundBoard.Views.SoundboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpokaSoundBoard.Views"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="28,24,20,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource FlatButton}" Margin="0,0,10,0" ToolTip="Partager : exporter ou importer une soundboard complète (sons inclus)"
                            Click="OnPackMenuClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72D;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Packs" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu FontFamily="{StaticResource UiFont}">
                                <MenuItem Header="Exporter ma soundboard (.spokapack)…" Command="{Binding ExportPackCommand}" />
                                <MenuItem Header="Importer une soundboard…" Command="{Binding ImportPackCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding StopAllCommand}" Margin="0,0,10,0" ToolTip="Arrêter tous les sons">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Tout arrêter" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleRecordingCommand}" Margin="0,0,10,0"
                            ToolTip="Enregistrer un son avec votre micro : il est ajouté à la soundboard quand vous arrêtez (2 minutes maximum)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                <Setter Property="AutomationProperties.Name" Value="Enregistrer un son avec le micro" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="AutomationProperties.Name" Value="Arrêter l'enregistrement" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource DangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Enregistrer" Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVis}}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Arrêter" />
                                <TextBlock Text="{Binding RecordingTime}" Margin="8,0,0,0" Foreground="{DynamicResource DangerBrush}" />
                                <ProgressBar Width="40" Height="4" Margin="8,0,0,0" VerticalAlignment="Center" Minimum="0" Maximum="1"
                                             Value="{Binding RecordingLevel, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}" Command="{Binding AddSoundsCommand}" ToolTip="Ajouter des fichiers audio de votre PC (MP3, WAV, OGG…)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Ajouter des sons" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Soundboard" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Cliquez sur un son pour le diffuser dans votre micro (cliquez à nouveau pour l'arrêter). Clic droit ou crayon pour le modifier et lui donner un raccourci clavier." />
                </StackPanel>
            </DockPanel>

            <!-- Find new sounds online (always visible) -->
            <!-- Clickable header: folds the search card to keep the pads in view -->
            <Button DockPanel.Dock="Top" Command="{Binding ToggleSoundSearchCommand}" HorizontalAlignment="Left" Margin="-8,0,0,6"
                    Padding="8,4" Background="Transparent" BorderBrush="Transparent" Style="{StaticResource FlatButton}"
                    AutomationProperties.Name="Trouver des sons : afficher ou replier">
                <Button.ToolTip>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Replier la recherche pour garder vos sons à l'écran" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Appearance.SoundSearchCollapsed}" Value="True">
                                        <Setter Property="Text" Value="Afficher la recherche (MyInstants, YouTube, liens)" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                <Setter Property="Text" Value="&#xE70D;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Appearance.SoundSearchCollapsed}" Value="True">
                                        <Setter Property="Text" Value="&#xE76C;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Trouver des sons" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="MyInstants, YouTube ou un lien" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,2,0,0"
                               Visibility="{Binding Appearance.SoundSearchCollapsed, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Button>
            <local:LinkBar DockPanel.Dock="Top" DataContext="{Binding Link}"
                           Visibility="{Binding DataContext.Appearance.SoundSearchCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVis}}" />

            <!-- My sounds: title and local filter -->
            <DockPanel DockPanel.Dock="Top" Margin="0,6,0,12" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                <Grid DockPanel.Dock="Right" Width="280">
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Filtrer mes sons" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="13" HorizontalAlignment="Left" Margin="10,0,0,0"
                               Foreground="{DynamicResource SubtleTextBrush}" IsHitTestVisible="False" />
                    <TextBlock Text="Filtrer mes sons…" Style="{StaticResource Caption}" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Visibility>
                            <Binding Path="Filter" Converter="{StaticResource InverseNullToVis}" />
                        </TextBlock.Visibility>
                    </TextBlock>
                </Grid>
                <TextBlock Style="{StaticResource SectionTitle}">
                    <Run Text="Mes sons" /><Run Text="{Binding Pads.Count, Mode=OneWay, StringFormat=' ({0})'}" Foreground="{DynamicResource SubtleTextBrush}" FontWeight="Normal" />
                </TextBlock>
            </DockPanel>

            <!-- Tabs: « Tous » and one per category. Drop a sound on a tab to move it there. -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsEditingCategory, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding CategoryEditTitle}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="CategoryBox" Width="170" Text="{Binding CategoryDraft, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"
                             VerticalContentAlignment="Center" AutomationProperties.Name="Nom de la catégorie" IsVisibleChanged="OnCategoryBoxVisible">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ConfirmCategoryCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelCategoryCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Style="{StaticResource IconButton}" Content="&#xE73E;" Margin="4,0,0,0" ToolTip="Valider"
                            AutomationProperties.Name="Valider le nom" Command="{Binding ConfirmCategoryCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Annuler"
                            AutomationProperties.Name="Annuler" Command="{Binding CancelCategoryCommand}" />
                </StackPanel>
                <WrapPanel>
                    <ItemsControl x:Name="TabList" ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="PadTabs" Margin="0,0,8,6" Cursor="Hand" AllowDrop="True"
                                             DragOver="OnTabDragOver" Drop="OnTabDrop" Tag="{Binding DataContext, ElementName=TabList}"
                                             Checked="OnTabChecked" AutomationProperties.Name="{Binding Label}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource MultiEquals}" Mode="OneWay">
                                            <Binding Path="Key" />
                                            <Binding Path="DataContext.SelectedCategory" ElementName="TabList" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                    <RadioButton.ContextMenu>
                                        <ContextMenu FontFamily="{StaticResource UiFont}" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Renommer…" Command="{Binding RenameCategoryCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext.Key, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Supprimer la catégorie (les sons restent)" Command="{Binding DeleteCategoryCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext.Key, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </RadioButton.ContextMenu>
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Chip" CornerRadius="14" Padding="12,5" BorderThickness="1"
                                                    Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" FontSize="12" />
                                                    <TextBlock Text="{Binding Count}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SubtleTextBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource FlatButton}" Padding="10,4" Margin="0,0,0,6" Command="{Binding NewCategoryCommand}"
                            ToolTip="Créer un onglet pour ranger vos sons (glissez ensuite un son sur un onglet pour l'y ranger)"
                            AutomationProperties.Name="Nouvelle catégorie">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="Catégorie" FontSize="12" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>

            <Grid>
                <!-- Empty state -->
                <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2" CornerRadius="14" Margin="0,0,0,24"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" FontSize="54" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Votre soundboard est vide" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                        <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" FontSize="13"
                                   Text="Glissez-déposez vos fichiers audio ici (MP3, WAV, OGG, FLAC, M4A…), un lien depuis votre navigateur, ou utilisez les boutons en haut à droite." />
                        <Button Style="{StaticResource AccentButton}" Content="Ajouter des sons" HorizontalAlignment="Center" Margin="0,18,0,0"
                                Command="{Binding AddSoundsCommand}" />
                    </StackPanel>
                </Border>

                <!-- Empty tab -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,8,0,0" MaxWidth="520"
                            Visibility="{Binding CategoryIsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Cette catégorie est vide" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Glissez un son depuis « Tous » sur cet onglet, choisissez la catégorie dans l'éditeur d'un son, ou ajoutez de nouveaux sons : ils arrivent dans l'onglet affiché." />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                    <ItemsControl x:Name="PadList" ItemsSource="{Binding PadsView}" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="{DynamicResource PadWidth}" Height="{DynamicResource PadHeight}" Margin="0,0,14,14" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                        AllowDrop="True" PreviewMouseLeftButtonDown="OnPadMouseDown" PreviewMouseMove="OnPadMouseMove"
                                        DragOver="OnPadDragOver" Drop="OnPadDrop" AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.PlayPadCommand, ElementName=PadList}" CommandParameter="{Binding}"
                                        Tag="{Binding DataContext, ElementName=PadList}" ToolTip="{Binding FilePath}">
                                    <Button.ContextMenu>
                                        <ContextMenu FontFamily="{StaticResource UiFont}" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Lire / arrêter" Command="{Binding PlayPadCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Écouter dans mon casque" Command="{Binding PreviewPadCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Modifier…" Command="{Binding EditPadCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Ouvrir la source" Command="{Binding Link.OpenSourceCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext.SourceUrl, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Visibility="{Binding PlacementTarget.DataContext.HasSource, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                                            <Separator />
                                            <MenuItem Header="Supprimer" Command="{Binding DeletePadCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Tile" CornerRadius="12" BorderThickness="1" Padding="14,12"
                                                    Background="{Binding Color, Converter={StaticResource HexToSoftBrush}}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Left"
                                                            Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                                                        <TextBlock x:Name="PlayIcon" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13" Foreground="White" />
                                                    </Border>
                                                    <Button x:Name="EditButton" Style="{StaticResource IconButton}" Content="&#xE70F;" FontSize="13" Padding="6"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden" ToolTip="Modifier"
                                                            Command="{Binding Tag.EditPadCommand, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=1}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}" />
                                                    <DockPanel Grid.Row="2">
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE7F6;" FontSize="11" Margin="6,0,0,0"
                                                                   Foreground="{DynamicResource SubtleTextBrush}" ToolTip="Moi seulement : joué dans votre casque, pas dans le micro"
                                                                   Visibility="{Binding HeadphonesOnly, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE8EE;" FontSize="11"
                                                                   Foreground="{DynamicResource SubtleTextBrush}" ToolTip="En boucle"
                                                                   Visibility="{Binding Loop, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="11" Margin="0,0,6,0"
                                                                   Foreground="{DynamicResource SubtleTextBrush}" ToolTip="{Binding SourceUrl}"
                                                                   Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}" />
                                                        <Border CornerRadius="4" Background="{DynamicResource InsetBrush}" Padding="6,2" HorizontalAlignment="Left">
                                                            <Border.Visibility>
                                                                <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                                                    <Binding Path="Hotkey.IsSet" />
                                                                    <Binding Path="DataContext.ShowHotkeys" ElementName="PadList" />
                                                                </MultiBinding>
                                                            </Border.Visibility>
                                                            <TextBlock Text="{Binding Hotkey.Display}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
                                                        </Border>
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                                    <Setter TargetName="EditButton" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                                    <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                                    <Setter TargetName="PlayIcon" Property="Text" Value="&#xE71A;" />
                                                </DataTrigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Tile" Property="Opacity" Value="0.8" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- Pad editor -->
        <Border Grid.Column="1" Width="320" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1,0,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" DataContext="{Binding SelectedPad}">
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Fermer"
                                Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=local:SoundboardView}}" />
                        <TextBlock Text="Modifier le son" Style="{StaticResource SectionTitle}" />
                    </DockPanel>

                    <TextBlock Text="Nom" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" AutomationProperties.Name="Nom du son" />

                    <TextBlock Text="Catégorie (vide = aucune)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <ComboBox IsEditable="True" Margin="0,0,0,14" Text="{Binding Category, UpdateSourceTrigger=LostFocus}"
                              ItemsSource="{Binding DataContext.CategoryNames, RelativeSource={RelativeSource AncestorType=local:SoundboardView}}"
                              AutomationProperties.Name="Catégorie du son" />

                    <TextBlock Text="Icône sur la télécommande" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <ComboBox Margin="0,0,0,14" SelectedValue="{Binding Icon}" SelectedValuePath="Key" DisplayMemberPath="Label"
                              ItemsSource="{Binding DataContext.IconChoices, RelativeSource={RelativeSource AncestorType=local:SoundboardView}}"
                              AutomationProperties.Name="Icône du son sur la télécommande" />

                    <TextBlock Text="Fichier" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="Changer" Style="{StaticResource FlatButton}" Padding="10,5" Margin="8,0,0,0"
                                Command="{Binding DataContext.ChangeFileCommand, RelativeSource={RelativeSource AncestorType=local:SoundboardView}}" />
                        <TextBlock Text="{Binding FilePath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   VerticalAlignment="Center" ToolTip="{Binding FilePath}" />
                    </DockPanel>

                    <DockPanel Margin="0,-8,0,14" Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Content="Ouvrir" Style="{StaticResource FlatButton}" Padding="10,5" Margin="8,0,0,0"
                                Command="{Binding DataContext.Link.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=local:SoundboardView}}"
                                CommandParameter="{Binding SourceUrl}" />
                        <TextBlock Text="{Binding SourceUrl}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Accent2Brush}" ToolTip="{Binding SourceUrl}" />
                    </DockPanel>

                    <local:SliderRow Label="Volume" Minimum="0" Maximum="2" Step="0.05" Format="%" Value="{Binding Volume}" />

                    <TextBlock Text="Extrait à jouer (en secondes)" Style="{StaticResource Caption}" Margin="0,10,0,4" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Début" Style="{StaticResource Label}" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Text="{Binding StartSeconds, StringFormat={}{0:0.#}}" VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Fin" Style="{StaticResource Label}" Margin="0,0,8,0" />
                        <TextBox Grid.Column="4" Text="{Binding EndSeconds, StringFormat={}{0:0.#}}" VerticalContentAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Fin = 0 : jusqu'au bout. Pratique pour ne garder qu'un passage d'une vidéo." Style="{StaticResource Caption}" Margin="0,0,0,4" />

                    <TextBlock Text="Couleur" Style="{StaticResource Caption}" Margin="0,10,0,6" />
                    <ItemsControl ItemsSource="{Binding DataContext.Colors, RelativeSource={RelativeSource AncestorType=local:SoundboardView}}" Margin="0,0,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="26" Height="26" Margin="0,0,6,6" Cursor="Hand"
                                        Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=local:SoundboardView}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Ellipse x:Name="Dot" Fill="{Binding Converter={StaticResource HexToBrush}}" Stroke="Transparent" StrokeThickness="2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Dot" Property="Stroke" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Loop}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Lecture en boucle" Style="{StaticResource Label}" />
                            <TextBlock Text="Rejoue le son jusqu'à ce que vous l'arrêtiez" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="Quand on rappuie pendant la lecture" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <ComboBox Margin="0,0,0,14" SelectedValue="{Binding PlayMode}" SelectedValuePath="Mode" DisplayMemberPath="Label"
                              ItemsSource="{Binding DataContext.PlayModes, RelativeSource={RelativeSource AncestorType=local:SoundboardView}}"
                              AutomationProperties.Name="Quand on rappuie pendant la lecture" />

                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StopOthers}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Arrêter les autres sons" Style="{StaticResource Label}" />
                            <TextBlock Text="Coupe les sons en cours quand celui-ci démarre" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HeadphonesOnly}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Moi seulement" Style="{StaticResource Label}" />
                            <TextBlock Text="Joué dans votre casque uniquement, personne d'autre ne l'entend" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="Raccourci global (fonctionne en jeu)" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                    <DockPanel Margin="0,0,0,22">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Effacer le raccourci"
                                Command="{Binding DataContext.ClearHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Hotkey}" />
                        <Button Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"
                                Command="{Binding DataContext.RecordHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Hotkey}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Hotkey.Display}" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Button Style="{StaticResource FlatButton}" Margin="0,0,6,0" ToolTip="Écouter dans votre casque, sans le diffuser dans le micro"
                                Command="{Binding DataContext.PreviewPadCommand, RelativeSource={RelativeSource AncestorType=local:SoundboardView}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F6;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Écouter" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AccentButton}" Margin="6,0,0,0" ToolTip="Diffuser dans le micro, comme un clic sur le son"
                                Command="{Binding DataContext.PlayPadCommand, RelativeSource={RelativeSource AncestorType=local:SoundboardView}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Diffuser" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <UniformGrid Columns="1">
                        <Button Style="{StaticResource DangerButton}"
                                Command="{Binding DataContext.DeletePadCommand, RelativeSource={RelativeSource AncestorType=local:SoundboardView}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Supprimer" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
