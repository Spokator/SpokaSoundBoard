<UserControl x:Class="SpokaSoundBoard.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: SetupWizardViewModel -->
    <Grid Background="#E607080C">
        <Border Style="{StaticResource Card}" Width="680" MaxHeight="660" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="0" Margin="20">
            <DockPanel>
                <!-- Header -->
                <DockPanel DockPanel.Dock="Top" Margin="28,22,18,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Fermer l'assistant (vous pourrez le relancer depuis Configuration)"
                            Command="{Binding CloseCommand}" VerticalAlignment="Top" />
                    <Image Source="/Assets/logo.png" Width="36" Height="36" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="Assistant de configuration · étape" />
                            <Run Text="{Binding StepNumber, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding TotalSteps, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding StepTitle}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </DockPanel>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="28,14">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" MinWidth="120" Command="{Binding NextCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NextLabel}" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="12" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Retour" Margin="0,0,10,0" Command="{Binding BackCommand}"
                                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" />
                        <ProgressBar Style="{StaticResource Meter}" Height="4" Maximum="5" Width="160" HorizontalAlignment="Left"
                                     Value="{Binding StepNumber, Mode=OneWay}" Foreground="{DynamicResource BrandBrush}" />
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <Grid Margin="28,0,28,20">

                        <!-- 0. Welcome -->
                        <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=0}">
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22">
                                SpokaSoundBoard diffuse votre musique, vos sons et votre voix avec effets dans Discord et dans vos jeux.
                                Cet assistant règle tout en 2 minutes :
                            </TextBlock>
                            <StackPanel Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,12,0" />
                                    <TextBlock Text="Vérifier votre micro" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F5;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,12,0" />
                                    <TextBlock Text="Installer le micro virtuel (gratuit, en un clic)" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,12,0" />
                                    <TextBlock Text="Configurer Discord et vos jeux" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Autostart}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Lancer SpokaSoundBoard au démarrage de Windows" Style="{StaticResource Label}" />
                                    <TextBlock Text="Il s'ouvre réduit dans la barre des tâches, prêt pour vos parties." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>

                        <!-- 1. Microphone -->
                        <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=1}">
                            <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                                    Visibility="{Binding MicrophoneBlocked, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Text="Windows bloque l'accès au micro pour les applications." />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,8"
                                               Text="Activez « Accès au microphone » et « Autoriser les applications de bureau à accéder au microphone », puis revenez ici." />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource AccentButton}" Content="Ouvrir les paramètres de confidentialité" Command="{Binding OpenMicrophonePrivacyCommand}" Margin="0,0,10,0" />
                                        <Button Style="{StaticResource FlatButton}" Content="Vérifier à nouveau" Command="{Binding RecheckMicrophoneCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Dans quel micro parlez-vous ?" Style="{StaticResource Label}" Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding Devices.Inputs}" SelectedItem="{Binding Devices.SelectedMic}" DisplayMemberPath="Name" />
                            <TextBlock Text="Parlez : la barre doit bouger." Style="{StaticResource Caption}" Margin="0,18,0,6" />
                            <ProgressBar Style="{StaticResource Meter}" Height="14"
                                         Value="{Binding DataContext.MicLevel, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0"
                                       Text="La barre ne bouge pas ? Choisissez un autre micro dans la liste, ou vérifiez qu'il n'est pas coupé (bouton mute du casque)." />
                        </StackPanel>

                        <!-- 2. Virtual microphones -->
                        <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=2}">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20"
                                       Text="Pour que les autres vous entendent avec la musique et les effets, Windows a besoin d'un « micro virtuel ». Cliquez sur Installer : la fenêtre officielle s'ouvre, acceptez l'autorisation administrateur puis cliquez sur « Install Driver » (ou « Install »)." />

                            <Border Style="{StaticResource Card}" Background="{DynamicResource SubCardBrush}" Padding="16" Margin="0,0,0,12">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Devices.HasVirtualCable, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="Installé" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Button Style="{StaticResource AccentButton}" Content="Installer" Command="{Binding InstallVirtualMicCommand}"
                                                Visibility="{Binding Devices.HasVirtualCable, Converter={StaticResource InverseBoolToVis}}"
                                                IsEnabled="{Binding Devices.IsInstalling, Converter={StaticResource InverseBool}}" />
                                    </Grid>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Micro virtuel principal (VB-CABLE)" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Text="Indispensable. Gratuit (donationware), par VB-Audio." />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Devices.InstallStatus}" Foreground="{DynamicResource Accent2Brush}" Margin="0,4,0,0"
                                                   Visibility="{Binding Devices.InstallStatus, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Background="{DynamicResource SubCardBrush}" Padding="16" Margin="0,0,0,12">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Devices.HasSecondCable, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="Installé" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Button Style="{StaticResource FlatButton}" Content="Installer" Command="{Binding InstallSecondCableCommand}"
                                                Visibility="{Binding Devices.HasSecondCable, Converter={StaticResource InverseBoolToVis}}"
                                                IsEnabled="{Binding Devices.IsInstallingSecond, Converter={StaticResource InverseBool}}" />
                                    </Grid>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Deuxième micro pour Discord (optionnel)" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="Pour que Discord n'entende pas la même chose que le jeu (ex. la musique seulement en jeu). Virtual Audio Cable Lite, gratuit pour un usage personnel." />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Devices.SecondInstallStatus}" Foreground="{DynamicResource Accent2Brush}" Margin="0,4,0,0"
                                                   Visibility="{Binding Devices.SecondInstallStatus, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="14,12"
                                    Visibility="{Binding NeedsReboot, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource FlatButton}" Content="Vérifier" Margin="0,0,8,0" Command="{Binding Devices.RefreshCommand}" />
                                        <Button Style="{StaticResource AccentButton}" Content="Redémarrer maintenant" Command="{Binding RestartNowCommand}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Un redémarrage peut être nécessaire" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="Si le micro n'apparaît pas encore comme « Installé », redémarrez : l'assistant se rouvrira tout seul juste après." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- 3. Discord & games -->
                        <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=3}">
                            <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                                    Visibility="{Binding Devices.HasVirtualCable, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                                           Text="Le micro virtuel n'est pas encore détecté. Revenez à l'étape précédente (ou redémarrez le PC) pour que les autres entendent la musique et vos effets." />
                            </Border>

                            <Border Style="{StaticResource Card}" Background="{DynamicResource SubCardBrush}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                                        <TextBlock Text="Dans Discord" FontWeight="SemiBold" FontSize="15" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap">
                                        Paramètres → Voix et vidéo → <Bold>Périphérique d'entrée</Bold> :
                                    </TextBlock>
                                    <DockPanel Margin="0,8,0,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Copier" Margin="8,0,0,0"
                                                Command="{Binding CopyCommand}" CommandParameter="{Binding DiscordInputName}" />
                                        <Border Background="{DynamicResource InsetBrush}" CornerRadius="6" Padding="12,8">
                                            <TextBlock Text="{Binding DiscordInputName}" Foreground="{DynamicResource Accent2Brush}" FontWeight="SemiBold" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="19">
                                        Dans la même page, sinon Discord coupe la musique par moments :<LineBreak />
                                        • Suppression du bruit : <Bold>Aucune</Bold> · Annulation de l'écho, Activité vocale avancée, Contrôle auto du gain : <Bold>désactivés</Bold><LineBreak />
                                        • Sensibilité d'entrée : « Déterminer automatiquement » désactivé, curseur <Bold>tout à gauche</Bold><LineBreak />
                                        • Atténuation : <Bold>0 %</Bold>
                                    </TextBlock>
                                    <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding OpenDiscordVoiceSettingsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Ouvrir les réglages voix de Discord" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Background="{DynamicResource SubCardBrush}" Padding="16" Margin="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                                        <TextBlock Text="Dans vos jeux" FontWeight="SemiBold" FontSize="15" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Options audio du jeu → Microphone :" />
                                    <DockPanel Margin="0,8,0,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Copier" Margin="8,0,0,0"
                                                Command="{Binding CopyCommand}" CommandParameter="{Binding Devices.VirtualMicName}" />
                                        <Border Background="{DynamicResource InsetBrush}" CornerRadius="6" Padding="12,8">
                                            <TextBlock Text="{Binding Devices.VirtualMicName}" Foreground="{DynamicResource Accent2Brush}" FontWeight="SemiBold" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="Si le jeu ne propose pas de choix, mettez ce micro par défaut dans les paramètres son de Windows. Gardez la touche « parler » du jeu comme d'habitude." />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding CopiedMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource SuccessBrush}" Margin="0,10,0,0"
                                       Visibility="{Binding CopiedMessage, Converter={StaticResource NullToVis}}" />
                        </StackPanel>

                        <!-- 4. Done -->
                        <StackPanel Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=4}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE930;" FontSize="48" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Left" />
                            <TextBlock FontSize="15" TextWrapping="Wrap" Margin="0,14,0,14" Text="Tout est prêt ! Quelques idées pour commencer :" />
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">• <Bold>Musique</Bold> : collez un lien YouTube ou glissez vos fichiers, la musique baisse toute seule quand vous parlez.</TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">• <Bold>Voix &amp; effets</Bold> : choisissez « Pilote d'hélico » pour la radio de cockpit.</TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">• <Bold>Mixage</Bold> : « Qui entend quoi ? » décide ce que le jeu et Discord entendent.</TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">• <Bold>Configuration</Bold> : des raccourcis clavier / souris utilisables en pleine partie.</TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" Text="Vous pouvez relancer cet assistant à tout moment depuis la page Configuration." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
