<UserControl x:Class="SpokaSoundBoard.Views.TextToSpeechPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpokaSoundBoard.Views"
             x:Name="Root">
    <!-- DataContext: TextToSpeechViewModel -->
    <UserControl.Resources>
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="14,12">
        <StackPanel>
            <!-- Always visible: type a phrase, press Enter -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                            ToolTip="Une voix de synthèse lit votre texte dans le micro, comme un son de la soundboard">
                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F2;" FontSize="14" Foreground="{DynamicResource Accent2Brush}" />
                    </Border>
                    <TextBlock Text="Synthèse vocale" Style="{StaticResource SectionTitle}" FontSize="14" Margin="10,0,0,0" />
                </StackPanel>

                <Grid Grid.Column="1">
                    <TextBox x:Name="PhraseBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" VerticalContentAlignment="Center"
                             MaxLength="500" IsEnabled="{Binding IsAvailable}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SpeakCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Tapez une phrase puis Entrée : elle est dite dans votre micro…" Style="{StaticResource Caption}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Visibility>
                            <Binding Path="Text" Converter="{StaticResource InverseNullToVis}" />
                        </TextBlock.Visibility>
                    </TextBlock>
                    <ProgressBar IsIndeterminate="True" VerticalAlignment="Bottom" Height="2" Margin="6,0,6,1"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Style="{StaticResource AccentButton}" Command="{Binding SpeakCommand}" Padding="14,7" ToolTip="Dire la phrase dans le micro (Entrée)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Dire" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" Padding="10,7" Margin="8,0,0,0" ToolTip="Arrêter la voix" AutomationProperties.Name="Arrêter la voix"
                            Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Command="{Binding SaveAsPadCommand}" Padding="10,7" Margin="8,0,0,0"
                            ToolTip="Enregistrer la dernière phrase comme son de la soundboard (pour lui donner un raccourci)"
                            AutomationProperties.Name="Enregistrer comme son">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" />
                    </Button>
                    <Button Command="{Binding ToggleExpandedCommand}" Margin="4,0,0,0" ToolTip="Voix, vitesse, phrases rapides et historique" AutomationProperties.Name="Options de la synthèse vocale">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="&#xE70D;" />
                                <Setter Property="FontSize" Value="13" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.IsExpanded}" Value="True">
                                        <Setter Property="Content" Value="&#xE70E;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVis}}">
                <Run Text="Aucune voix de synthèse sur ce PC : téléchargez les voix naturelles (" /><Run Text="{Binding PackSizeText, Mode=OneWay}" /><Run Text=") dans les options ci-dessous, ou ajoutez une voix dans Paramètres Windows → Heure et langue → Voix." />
            </TextBlock>

            <!-- Folded: invitation to try the natural voices -->
            <DockPanel Margin="0,8,0,0" Visibility="{Binding ShowCollapsedHint, Converter={StaticResource BoolToVis}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="10,4" FontSize="12"
                        Command="{Binding ToggleExpandedCommand}" Content="Découvrir" />
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="&#xE945;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent2Brush}" />
                    <Run Text=" Voix trop robotique ? Les voix naturelles sonnent bien plus humain et fonctionnent hors ligne." />
                </TextBlock>
            </DockPanel>

            <!-- Options -->
            <StackPanel Margin="0,14,0,0" Visibility="{Binding Settings.IsExpanded, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top" Margin="0,6,0,0">
                        <TextBlock Text="Voix" Style="{StaticResource Label}" Margin="0,0,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="12" Padding="8" Margin="6,0,0,0"
                                    Command="{Binding PreviewVoiceCommand}" IsEnabled="{Binding IsAvailable}"
                                    ToolTip="Écouter un aperçu de la voix dans le casque (pas dans le micro)" AutomationProperties.Name="Écouter un aperçu de la voix" />
                            <ComboBox ItemsSource="{Binding VoicesView}" SelectedItem="{Binding SelectedVoice}" DisplayMemberPath="Display"
                                      IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="Voix">
                                <ComboBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="10,8,0,4" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ComboBox.GroupStyle>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding SelectedNeedsDownload, Converter={StaticResource BoolToVis}}"
                                   Text="Cette voix naturelle n'est pas encore téléchargée : la voix Windows parle en attendant." />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasNoFrenchVoice, Converter={StaticResource BoolToVis}}"
                                   Text="Pas de voix Windows française : téléchargez les voix naturelles ou installez-la dans Paramètres Windows → Heure et langue → Voix." />
                    </StackPanel>
                    <local:SliderRow Grid.Column="2" Label="Vitesse" Minimum="0.5" Maximum="3" Step="0.1" Format="{}{0:0.0} ×"
                                     Value="{Binding Settings.Rate}" />
                    <Grid Grid.Column="4">
                        <local:SliderRow Label="Hauteur" Minimum="0.3" Maximum="2" Step="0.1" Format="{}{0:0.0}"
                                         Value="{Binding Settings.Pitch}" Description="Grave ← 1 → aigu"
                                         Visibility="{Binding ShowPitch, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Margin="0,6" Visibility="{Binding IsNaturalSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Hauteur" Style="{StaticResource Label}" Foreground="{DynamicResource SubtleTextBrush}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Non réglable avec les voix naturelles : choisissez plutôt une autre voix (femme ou homme)." />
                        </StackPanel>
                    </Grid>
                    <local:SliderRow Grid.Column="6" Label="Volume" Minimum="0" Maximum="2" Step="0.05" Format="%"
                                     Value="{Binding Settings.Volume}" />
                </Grid>

                <!-- Natural voices: download offer / progress / installed -->
                <Border Background="{DynamicResource SubCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Offer -->
                        <DockPanel Visibility="{Binding ShowNaturalOffer, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="12,6" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding DownloadNaturalCommand}" ToolTip="Télécharger le modèle des voix naturelles (une seule fois)"
                                    AutomationProperties.Name="Télécharger les voix naturelles">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock>
                                        <Run Text="Télécharger (" /><Run Text="{Binding PackSizeText, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="Voix naturelles" Style="{StaticResource Label}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="10 voix neuronales (5 femmes, 5 hommes) bien plus réalistes que les voix Windows, en français et dans 30 autres langues. Elles fonctionnent hors ligne, sur votre PC." />
                            </StackPanel>
                        </DockPanel>

                        <!-- Download in progress -->
                        <DockPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding CancelDownloadCommand}" Content="Annuler" />
                            <StackPanel>
                                <TextBlock Text="{Binding DownloadStatus}" Style="{StaticResource Label}" />
                                <ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding DownloadPercent, Mode=OneWay}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Installed -->
                        <DockPanel Visibility="{Binding IsNaturalInstalled, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="12" Padding="8" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Command="{Binding DeleteNaturalCommand}"
                                    ToolTip="Supprimer les voix naturelles du PC" AutomationProperties.Name="Supprimer les voix naturelles" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="Langue lue" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name" MinWidth="130"
                                          ToolTip="Langue de vos phrases (le texte n'est pas traduit)" AutomationProperties.Name="Langue lue par les voix naturelles" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold">
                                    <Run Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SuccessBrush}" />
                                    <Run Text=" Voix naturelles installées (" /><Run Text="{Binding PackSizeText, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="Choisissez une voix dans la liste et écoutez-la avec ▶ ; indiquez à droite la langue de vos phrases." />
                            </StackPanel>
                        </DockPanel>

                        <!-- License (shown before and after downloading) -->
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11">
                            <Run Text="{Binding LicenseText, Mode=OneWay}" />
                            <Hyperlink Command="{Binding OpenLicenseCommand}" Foreground="{DynamicResource Accent2Brush}">Lire la licence</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="Phrases rapides" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,12,0,8" />
                <ItemsControl ItemsSource="{Binding QuickPhrases}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChipButton}" Content="{Binding}"
                                    Command="{Binding DataContext.SpeakPhraseCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding History.Count, Converter={StaticResource CountToVis}}">
                    <DockPanel Margin="0,6,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="12" Padding="6"
                                ToolTip="Effacer l'historique" AutomationProperties.Name="Effacer l'historique" Command="{Binding ClearHistoryCommand}" />
                        <TextBlock Text="Récemment (cliquez pour redire)" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChipButton}" ToolTip="{Binding}"
                                        Command="{Binding DataContext.SpeakPhraseCommand, ElementName=Root}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="11" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource SubtleTextBrush}" />
                                        <TextBlock Text="{Binding}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
