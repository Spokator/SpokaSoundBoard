<UserControl x:Class="SpokaSoundBoard.Views.VoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpokaSoundBoard.Views"
             xmlns:models="clr-namespace:SpokaSoundBoard.Core.Models;assembly=SpokaSoundBoard.Core"
             x:Name="Root" IsVisibleChanged="OnVisibleChanged">
    <!-- DataContext: MainViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VoiceSettings.EffectsEnabled}" VerticalAlignment="Center">
                        <TextBlock Text="Effets activés" FontWeight="SemiBold" />
                    </CheckBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Voix &amp; effets" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Choisissez un effet prêt à l'emploi puis ajustez chaque réglage. Activez « M'écouter » (avec un casque) pour entendre le résultat en direct." />
                </StackPanel>
            </DockPanel>

            <!-- AI voice changer -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VoiceChanger.IsSwitchOn}" VerticalAlignment="Center"
                                  IsEnabled="{Binding VoiceChanger.CanTurnOn}" AutomationProperties.Name="Changeur de voix IA" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Changeur de voix IA" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Votre voix prend le timbre de la voix choisie, en direct, en gardant votre intonation, vos rires et vos cris : dans le jeu et sur Discord, c'est elle qu'on entend. Choisissez une des 10 voix ou créez les vôtres à partir d'enregistrements. Les effets plus bas (radio, écho…) s'appliquent en plus. Il faut une carte graphique (DirectX 12)." />

                    <DockPanel Margin="0,0,0,12">
                        <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource IdleDotBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VoiceChanger.IsOn}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VoiceChanger.NoGpu}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding VoiceChanger.Status}" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Délai" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <RadioButton GroupName="ChangerMode" IsChecked="{Binding VoiceChanger.IsReactive}" Margin="0,0,16,0" VerticalAlignment="Center"
                                     Content="Réactif (environ 0,5 s)" ToolTip="Le plus court délai. La voix est un tout petit peu moins fidèle." />
                        <RadioButton GroupName="ChangerMode" IsChecked="{Binding VoiceChanger.IsStable}" VerticalAlignment="Center"
                                     Content="Stable (environ 0,7 s)" ToolTip="Un peu plus de délai, une voix un peu plus fidèle et plus de marge si le jeu charge la carte graphique." />
                    </StackPanel>

                    <ItemsControl x:Name="ChangerVoices" ItemsSource="{Binding VoiceChanger.Voices}" AutomationProperties.Name="Voix du changeur de voix">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="178" Margin="0,0,10,10">
                                    <Button Cursor="Hand" AutomationProperties.Name="{Binding Title}" ToolTip="Parler avec cette voix"
                                            Command="{Binding DataContext.VoiceChanger.SelectVoiceCommand, ElementName=ChangerVoices}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" CornerRadius="10" BorderThickness="1" Padding="12,9" MinHeight="52"
                                                        Background="{DynamicResource SubCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
                                                    <DockPanel>
                                                        <Grid DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="15" Foreground="{DynamicResource Accent2Brush}"
                                                                       Visibility="{Binding IsCustom, Converter={StaticResource InverseBoolToVis}}" />
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="15" Foreground="{DynamicResource SuccessBrush}"
                                                                       Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="10" Padding="5" Margin="0,0,6,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Supprimer cette voix" AutomationProperties.Name="Supprimer cette voix"
                                            Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.VoiceChanger.DeleteVoiceCommand, ElementName=ChangerVoices}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,10"
                            Command="{Binding VoiceChanger.OpenCreatorCommand}" AutomationProperties.Name="Créer une voix"
                            Visibility="{Binding VoiceChanger.IsCreating, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Créer une voix (la vôtre, celle d'un personnage…)" />
                        </StackPanel>
                    </Button>

                    <!-- « Mes voix »: making a voice from recordings or files -->
                    <Border Background="{DynamicResource SubCardBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="16,14" Margin="0,0,0,12"
                            Visibility="{Binding VoiceChanger.IsCreating, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Nouvelle voix" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Enregistrez-vous, ou importez des fichiers où l'on entend surtout cette voix (dialogues, répliques d'un personnage…). Le mieux : 20 à 60 secondes, au calme, avec des phrases variées et le ton voulu. Les silences et la musique de fond sont mis de côté autant que possible." />

                            <TextBlock Text="Nom" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding VoiceChanger.NewVoiceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Padding="8,5"
                                     Margin="0,0,0,12" AutomationProperties.Name="Nom de la nouvelle voix" />

                            <WrapPanel Margin="0,0,0,8">
                                <Button Style="{StaticResource AccentButton}" Padding="12,7" Margin="0,0,10,6" Command="{Binding VoiceChanger.ToggleRecordingCommand}"
                                        AutomationProperties.Name="Enregistrer avec le micro"
                                        Visibility="{Binding VoiceChanger.IsRecording, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Enregistrer avec le micro" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerButton}" Padding="12,7" Margin="0,0,10,6" Command="{Binding VoiceChanger.ToggleRecordingCommand}"
                                        AutomationProperties.Name="Arrêter l'enregistrement"
                                        Visibility="{Binding VoiceChanger.IsRecording, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock>
                                            <Run Text="Arrêter (" /><Run Text="{Binding VoiceChanger.RecordingSeconds, Mode=OneWay, StringFormat={}{0:0} s}" /><Run Text=")" />
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" Padding="12,7" Margin="0,0,10,6" Command="{Binding VoiceChanger.ImportClipsCommand}"
                                        AutomationProperties.Name="Importer des fichiers de voix">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="Importer des fichiers…" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding VoiceChanger.RecordingLevel, Mode=OneWay}" Margin="0,0,0,8"
                                         Visibility="{Binding VoiceChanger.IsRecording, Converter={StaticResource BoolToVis}}" />

                            <ItemsControl ItemsSource="{Binding VoiceChanger.Clips}" x:Name="ClipList" AutomationProperties.Name="Extraits de la nouvelle voix">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InsetBrush}" CornerRadius="6" Padding="10,5" Margin="0,0,0,4">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Padding="4"
                                                        ToolTip="Retirer" AutomationProperties.Name="Retirer cet extrait"
                                                        Command="{Binding DataContext.VoiceChanger.RemoveClipCommand, ElementName=ClipList}" CommandParameter="{Binding}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Seconds, StringFormat={}{0:0} s}" Style="{StaticResource Caption}"
                                                           Margin="10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding VoiceChanger.ClipsSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10" />

                            <CheckBox IsChecked="{Binding VoiceChanger.Consent}" Margin="0,0,0,12" AutomationProperties.Name="Consentement">
                                <TextBlock TextWrapping="Wrap"
                                           Text="C'est ma voix, ou j'ai l'accord de la personne à qui elle appartient (ou c'est un personnage que j'ai créé). Imiter quelqu'un sans son accord est interdit." />
                            </CheckBox>

                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="14,7" Margin="10,0,0,0"
                                        Command="{Binding VoiceChanger.CreateVoiceCommand}" Content="Créer la voix" AutomationProperties.Name="Créer la voix" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="12,7"
                                        Command="{Binding VoiceChanger.CancelCreatorCommand}" Content="Annuler" />
                                <StackPanel VerticalAlignment="Center" Visibility="{Binding VoiceChanger.IsBuilding, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding VoiceChanger.BuildStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    <ProgressBar Height="3" IsIndeterminate="True" Margin="0,4,12,0" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Models: offer, progress, installed -->
                    <Border Background="{DynamicResource SubCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,12" Margin="0,4,0,8">
                        <StackPanel>
                            <DockPanel Visibility="{Binding VoiceChanger.ShowDownload, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="12,6" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding VoiceChanger.DownloadCommand}" AutomationProperties.Name="Télécharger le changeur de voix">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock>
                                            <Run Text="Télécharger (" /><Run Text="{Binding VoiceChanger.PackSizeText, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="Modèles du changeur de voix" Style="{StaticResource Label}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Text="À télécharger une seule fois. Ils fonctionnent ensuite hors ligne, sur votre carte graphique." />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Visibility="{Binding VoiceChanger.IsDownloading, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding VoiceChanger.CancelDownloadCommand}" Content="Annuler" />
                                <StackPanel>
                                    <TextBlock Text="{Binding VoiceChanger.DownloadStatus}" Style="{StaticResource Label}" />
                                    <ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding VoiceChanger.DownloadPercent, Mode=OneWay}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Visibility="{Binding VoiceChanger.IsInstalled, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="12" Padding="8" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding VoiceChanger.DeleteCommand}"
                                        ToolTip="Supprimer les modèles du changeur de voix" AutomationProperties.Name="Supprimer les modèles du changeur de voix" />
                                <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <Run Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SuccessBrush}" />
                                    <Run Text=" Modèles installés (" /><Run Text="{Binding VoiceChanger.PackSizeText, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11">
                                <Run Text="{Binding VoiceChanger.LicenseText, Mode=OneWay}" />
                                <Hyperlink Command="{Binding VoiceChanger.OpenLicenseCommand}" Foreground="{DynamicResource Accent2Brush}">Lire les licences</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" FontSize="11"
                               Text="Raccourci global et bouton de télécommande : « Changeur de voix IA » (Configuration → Raccourcis globaux). Il ne s'active jamais tout seul au démarrage." />
                </StackPanel>
            </Border>

            <!-- Presets -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="10,5" FontSize="12"
                                Content="Réinitialiser la voix" Command="{Binding Voice.ResetVoiceCommand}" />
                        <TextBlock Text="Effets prêts à l'emploi" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <ItemsControl x:Name="PresetList" ItemsSource="{Binding Voice.Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="190" Height="86" Margin="0,0,10,10" Cursor="Hand" ToolTip="{Binding Description}"
                                        Command="{Binding DataContext.Voice.ApplyPresetCommand, ElementName=PresetList}" CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" CornerRadius="10" BorderThickness="1" Padding="12,10"
                                                    Background="{DynamicResource SubCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="15" Foreground="{DynamicResource Accent2Brush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="11"
                                                                   MaxHeight="32" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button x:Name="Delete" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                                            Padding="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"
                                                            ToolTip="Supprimer ce preset"
                                                            Command="{Binding DataContext.Voice.DeletePresetCommand, ElementName=PresetList}" CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                </Trigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsCustom}" Value="True" />
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="Delete" Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource MultiEquals}">
                                                            <Binding Path="Name" />
                                                            <Binding Path="DataContext.Voice.SelectedPresetName" ElementName="PresetList" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Enregistrer mes réglages" Margin="10,0,0,0"
                                Command="{Binding Voice.SavePresetCommand}" />
                        <TextBox Text="{Binding Voice.NewPresetName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                 ToolTip="Nom de votre preset personnalisé" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Donnez un nom pour sauvegarder les réglages actuels comme preset personnel." />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Micro" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <local:ThresholdMeter Margin="0,0,0,8" />
                            <local:SliderRow Label="Gain du micro" Minimum="-12" Maximum="24" Step="0.5" Format="dB"
                                             Value="{Binding VoiceSettings.InputGainDb}" Description="Augmentez si votre micro est trop faible." />
                            <local:SliderRow Label="Volume de votre voix" Minimum="-24" Maximum="12" Step="0.5" Format="dB"
                                             Value="{Binding VoiceSettings.VoiceVolumeDb}" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VoiceSettings.GateEnabled}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Porte de bruit" Style="{StaticResource Label}" />
                                    <TextBlock Text="Coupe le micro sous le seuil (clavier, ventilateur…)" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Mix.NoiseSuppressionEnabled}" Margin="0,12,0,0"
                                      IsEnabled="{Binding NoiseSuppressionAvailable}" AutomationProperties.Name="Suppression du bruit">
                                <StackPanel>
                                    <TextBlock Text="Suppression du bruit" Style="{StaticResource Label}" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="{Binding NoiseSuppressionCaption}" />
                                </StackPanel>
                            </CheckBox>
                            <local:SliderRow Label="Intensité" Minimum="0" Maximum="1" Step="0.05" Format="%" Margin="0,4,0,0"
                                             Value="{Binding Mix.NoiseSuppressionAmount}"
                                             IsEnabled="{Binding Mix.NoiseSuppressionEnabled}"
                                             Visibility="{Binding NoiseSuppressionAvailable, Converter={StaticResource BoolToVis}}"
                                             Description="Moins de 100 % garde un peu du son d'origine, si votre voix vous semble trop « traitée »." />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Mix.ListenToSelf}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="M'écouter (test)" Style="{StaticResource Label}" />
                                    <TextBlock Text="Entendre votre voix avec effets dans le casque. Utilisez un casque pour éviter le larsen !" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VoiceSettings.RadioEnabled}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE709;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                                    <TextBlock Text="Radio / pilote" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                       Text="Son de radio de cockpit : bande étroite, saturation, souffle et grésillement à chaque prise de parole." />
                            <StackPanel IsEnabled="{Binding VoiceSettings.RadioEnabled}">
                                <local:SliderRow Label="Coupure des graves" Minimum="100" Maximum="1200" Step="10" Format="{}{0:0} Hz"
                                                 Value="{Binding VoiceSettings.RadioLowCutHz}" />
                                <local:SliderRow Label="Coupure des aigus" Minimum="1500" Maximum="6000" Step="50" Format="{}{0:0} Hz"
                                                 Value="{Binding VoiceSettings.RadioHighCutHz}" />
                                <local:SliderRow Label="Saturation" Minimum="0" Maximum="1" Format="%" Value="{Binding VoiceSettings.RadioDrive}" />
                                <local:SliderRow Label="Souffle radio" Minimum="0" Maximum="1" Format="%" Value="{Binding VoiceSettings.RadioNoise}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VoiceSettings.SquelchEnabled}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Squelch (pschht)" Style="{StaticResource Label}" />
                                        <TextBlock Text="Grésillement au début et à la fin de chaque phrase" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VoiceSettings.RogerBeepEnabled}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Bips radio" Style="{StaticResource Label}" />
                                        <TextBlock Text="Bip quand vous arrêtez (ou commencez) de parler" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </CheckBox>
                                <ComboBox Margin="0,8,0,0" SelectedValuePath="Tag" SelectedValue="{Binding VoiceSettings.BeepStyle}"
                                          IsEnabled="{Binding VoiceSettings.RogerBeepEnabled}">
                                    <ComboBoxItem Content="Roger beep (deux tons, à la fin)" Tag="{x:Static models:RadioBeepStyle.Roger}" />
                                    <ComboBoxItem Content="NASA « Quindar » (début et fin)" Tag="{x:Static models:RadioBeepStyle.Nasa}" />
                                    <ComboBoxItem Content="Bip simple (à la fin)" Tag="{x:Static models:RadioBeepStyle.Simple}" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VoiceSettings.EqEnabled}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                                    <TextBlock Text="Égaliseur" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6" Text="Donnez du corps (graves) ou de la clarté (aigus) à votre voix." />
                            <StackPanel IsEnabled="{Binding VoiceSettings.EqEnabled}">
                                <local:SliderRow Label="Graves" Minimum="-12" Maximum="12" Step="0.5" Format="dB" Value="{Binding VoiceSettings.EqLowDb}" />
                                <local:SliderRow Label="Médiums" Minimum="-12" Maximum="12" Step="0.5" Format="dB" Value="{Binding VoiceSettings.EqMidDb}" />
                                <local:SliderRow Label="Aigus" Minimum="-12" Maximum="12" Step="0.5" Format="dB" Value="{Binding VoiceSettings.EqHighDb}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VoiceSettings.LofiEnabled}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                                    <TextBlock Text="Distorsion / Lo-fi" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel IsEnabled="{Binding VoiceSettings.LofiEnabled}">
                                <local:SliderRow Label="Saturation" Minimum="0" Maximum="1" Step="0.05" Format="%" Value="{Binding VoiceSettings.LofiDrive}" />
                                <local:SliderRow Label="Résolution" Minimum="3" Maximum="16" Step="1" Format="{}{0:0} bits" Value="{Binding VoiceSettings.LofiBits}" Description="16 = propre, 4 = très « 8 bits »" />
                                <local:SliderRow Label="Dégradation" Minimum="1" Maximum="10" Step="1" Format="{}x{0:0}" Value="{Binding VoiceSettings.LofiDownsample}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right column -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                                <TextBlock Text="Hauteur de la voix" Style="{StaticResource SectionTitle}" />
                            </StackPanel>
                            <local:SliderRow Label="Hauteur (négatif = grave, positif = aigu)" Minimum="-12" Maximum="12" Step="1" Format="st"
                                             Value="{Binding VoiceSettings.PitchSemitones}" Description="0 = voix naturelle" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VoiceSettings.RobotEnabled}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE99A;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                                    <TextBlock Text="Robot" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel IsEnabled="{Binding VoiceSettings.RobotEnabled}">
                                <local:SliderRow Label="Fréquence" Minimum="20" Maximum="300" Step="5" Format="{}{0:0} Hz" Value="{Binding VoiceSettings.RobotFrequency}" />
                                <local:SliderRow Label="Intensité" Minimum="0" Maximum="1" Format="%" Value="{Binding VoiceSettings.RobotMix}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VoiceSettings.EchoEnabled}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE909;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                                    <TextBlock Text="Écho" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel IsEnabled="{Binding VoiceSettings.EchoEnabled}">
                                <local:SliderRow Label="Délai" Minimum="40" Maximum="1000" Step="10" Format="{}{0:0} ms" Value="{Binding VoiceSettings.EchoDelayMs}" />
                                <local:SliderRow Label="Répétitions" Minimum="0" Maximum="0.9" Format="%" Value="{Binding VoiceSettings.EchoFeedback}" />
                                <local:SliderRow Label="Niveau" Minimum="0" Maximum="1" Format="%" Value="{Binding VoiceSettings.EchoMix}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VoiceSettings.ReverbEnabled}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                                    <TextBlock Text="Réverbération" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel IsEnabled="{Binding VoiceSettings.ReverbEnabled}">
                                <local:SliderRow Label="Taille de la pièce" Minimum="0" Maximum="1" Format="%" Value="{Binding VoiceSettings.ReverbSize}" />
                                <local:SliderRow Label="Niveau" Minimum="0" Maximum="1" Format="%" Value="{Binding VoiceSettings.ReverbMix}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VoiceSettings.CompressorEnabled}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                                    <TextBlock Text="Compresseur" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <local:SliderRow Label="Intensité" Minimum="0" Maximum="1" Format="%" Value="{Binding VoiceSettings.CompressorAmount}"
                                             IsEnabled="{Binding VoiceSettings.CompressorEnabled}"
                                             Description="Égalise votre volume : la voix reste claire au-dessus de la musique." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VoiceSettings.ChorusEnabled}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B1;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                                    <TextBlock Text="Chorus / dédoublement" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel IsEnabled="{Binding VoiceSettings.ChorusEnabled}">
                                <local:SliderRow Label="Vitesse" Minimum="0.1" Maximum="8" Step="0.1" Format="{}{0:0.0} Hz" Value="{Binding VoiceSettings.ChorusRate}" />
                                <local:SliderRow Label="Profondeur" Minimum="0" Maximum="1" Step="0.05" Format="%" Value="{Binding VoiceSettings.ChorusDepth}" />
                                <local:SliderRow Label="Niveau" Minimum="0" Maximum="1" Step="0.05" Format="%" Value="{Binding VoiceSettings.ChorusMix}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VoiceSettings.MuffleEnabled}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9C8;" Foreground="{DynamicResource Accent2Brush}" Margin="0,0,10,0" />
                                    <TextBlock Text="Filtre étouffé" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel IsEnabled="{Binding VoiceSettings.MuffleEnabled}">
                                <local:SliderRow Label="Coupure" Minimum="200" Maximum="8000" Step="50" Format="{}{0:0} Hz" Value="{Binding VoiceSettings.MuffleHz}" Description="Bas = derrière un mur / sous l'eau" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
