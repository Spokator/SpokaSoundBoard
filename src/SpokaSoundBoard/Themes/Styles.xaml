<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:SpokaSoundBoard.Converters"
                    xmlns:views="clr-namespace:SpokaSoundBoard.Views"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Palette -->
    <Color x:Key="AccentColor">#7C5CFF</Color>
    <Color x:Key="Accent2Color">#22D3EE</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#337C5CFF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="White" />
    <SolidColorBrush x:Key="WindowBrush" Color="#0F1117" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#141722" />
    <SolidColorBrush x:Key="CardBrush" Color="#1A1E2B" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#222738" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A3042" />
    <SolidColorBrush x:Key="TextBrush" Color="#F1F3F9" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9AA3B8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F43F5E" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#26F59E0B" />
    <SolidColorBrush x:Key="MeterTrackBrush" Color="#262B3B" />
    <SolidColorBrush x:Key="ControlBrush" Color="#262B3B" />
    <SolidColorBrush x:Key="SubCardBrush" Color="#20263A" />
    <SolidColorBrush x:Key="InsetBrush" Color="#33000000" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#343B50" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#56607A" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#2C3245" />
    <SolidColorBrush x:Key="ToggleOffBorderBrush" Color="#4A5268" />
    <SolidColorBrush x:Key="ToggleKnobBrush" Color="#C9CFDD" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1EFFFFFF" />
    <SolidColorBrush x:Key="ToastBrush" Color="#F0262B3B" />
    <SolidColorBrush x:Key="IdleDotBrush" Color="#3A4155" />
    <sys:Double x:Key="PadWidth">176</sys:Double>
    <sys:Double x:Key="PadHeight">122</sys:Double>
    <LinearGradientBrush x:Key="MeterBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#22C55E" />
        <GradientStop Offset="0.7" Color="#A3E635" />
        <GradientStop Offset="0.88" Color="#F59E0B" />
        <GradientStop Offset="1" Color="#F43F5E" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#7C5CFF" />
        <GradientStop Offset="1" Color="#22D3EE" />
    </LinearGradientBrush>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

    <!-- Tooltips inherit the font of their owner: icon buttons use the icon font, so text tooltips must reset it. -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="9,5" MaxWidth="360">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Converters -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />
    <conv:NullToVisibilityConverter x:Key="InverseNullToVis" Invert="True" />
    <conv:EqualsToVisibilityConverter x:Key="EqualsToVis" />
    <conv:EqualsConverter x:Key="EqualsConv" />
    <conv:HexToBrushConverter x:Key="HexToBrush" />
    <conv:HexToBrushConverter x:Key="HexToSoftBrush" Opacity="0.18" />
    <conv:PercentConverter x:Key="Percent" />
    <conv:DbConverter x:Key="Db" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:NullableBoolToIndexConverter x:Key="NullableBoolIndex" />
    <conv:KeepChoiceConverter x:Key="KeepChoice" />
    <conv:MultiEqualsConverter x:Key="MultiEquals" />
    <conv:AllTrueToVisibilityConverter x:Key="AllTrueToVis" />
    <conv:CoverConverter x:Key="Cover" DecodeWidth="96" />
    <conv:CoverConverter x:Key="CoverLarge" DecodeWidth="480" />
    <conv:ArrayConverter x:Key="ArrayConv" />
    <conv:ScaleConverter x:Key="Scale" />
    <conv:CountToVisibilityConverter x:Key="CountToVis" />
    <conv:NullToBoolConverter x:Key="NullToBool" />
    <conv:RankConverter x:Key="RankConv" />

    <!-- Text -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Accent2Brush}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Cards -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- Toggle switch (CheckBox) -->
    <!-- Keyboard focus: a ring around the control, shown only while navigating with the keyboard (not after a click). -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="9" RadiusY="9" StrokeThickness="2" Stroke="{DynamicResource Accent2Brush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Border x:Name="Track" Grid.Column="1" Width="42" Height="22" CornerRadius="11"
                                Background="{DynamicResource ToggleOffBrush}" BorderBrush="{DynamicResource ToggleOffBorderBrush}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{DynamicResource ToggleKnobBrush}"
                                     HorizontalAlignment="Left" Margin="4,0,0,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar navigation -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Style.Triggers>
            <Trigger Property="views:LayoutAssist.Compact" Value="True">
                <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                <Setter Property="ToolTipService.Placement" Value="Right" />
            </Trigger>
        </Style.Triggers>
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="8" Background="Transparent" Padding="12,10">
                        <Grid>
                            <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                    Margin="-12,0,0,0" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            <StackPanel x:Name="Row" Orientation="Horizontal">
                                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" Margin="0,0,12,0"
                                           Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter x:Name="Label" VerticalAlignment="Center" TextElement.FontSize="14"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="views:LayoutAssist.Compact" Value="True">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Glyph" Property="Margin" Value="0" />
                            <Setter TargetName="Glyph" Property="FontSize" Value="18" />
                            <Setter TargetName="Bg" Property="Padding" Value="0,10" />
                            <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Bar" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons -->
    <Style x:Key="FlatButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Background" Value="#33F43F5E" />
        <Setter Property="BorderBrush" Value="#66F43F5E" />
    </Style>
    <Style x:Key="IconButton" TargetType="ButtonBase" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="ToggleIconButton" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Accent2Brush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Level meter -->
    <Style x:Key="Meter" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="4" Background="{DynamicResource MeterTrackBrush}" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource MeterBrush}" />
    </Style>

    <!-- Labelled slider row: Tag = label -->
    <Style x:Key="SettingSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,2,0,2" />
    </Style>
</ResourceDictionary>
