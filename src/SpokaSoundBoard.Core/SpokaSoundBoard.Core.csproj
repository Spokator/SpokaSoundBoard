<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <!-- Offline neural text-to-speech (Apache-2.0; GPL-free since 2.0: espeak-ng is no longer inside). -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpokaSoundBoard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microphone noise suppression: Xiph RNNoise 0.2 (BSD-3-Clause), built by native/rnnoise/build-rnnoise.ps1. -->
    <None Include="native/win-x64/rnnoise.dll" Link="rnnoise.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="native/win-x64/RNNOISE-LICENSE.txt" Link="RNNOISE-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
